{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Machine-readable proof schema for STATE.md verification. All proof JSONs must conform.",
  "common_required": [
    "command",
    "exit_code",
    "timestamp",
    "git_commit",
    "git_branch",
    "evidence_fingerprint"
  ],
  "evidence_fields": {
    "PROOF_PROVENANCE": ["stdout", "stderr", "command", "exit_code"],
    "PROOF_GATE_C": ["command", "exit_code", "gatec_log", "ui_smoke"],
    "PROOF_INSTALLER": ["command", "exit_code", "all_passed", "results"],
    "PROOF_PAYLOAD_DETOX": ["command", "exit_code", "moved_payloads", "check_repo_payloads", "policy_file_summary"],
    "PROOF_PHASE_3": ["phase", "date", "checks", "command", "exit_code"],
    "PROOF_PHASE_2_1": ["phase", "date", "checks", "command", "exit_code"],
    "PROOF_PHASE": ["phase", "date", "checks"],
    "PROOF_GOLDEN_PATH": [
      "command", "exit_code", "engine_mode", "model_hashes",
      "output_file_hash", "output_duration_seconds",
      "output_energy_rms", "all_steps_passed", "git_commit"
    ],
    "PROOF_UI_COMMAND_SURFACE": [
      "command", "exit_code", "commands_checked", "panels_checked",
      "all_commands_registered", "all_panels_registered"
    ],
    "PROOF_CRASH_RECOVERY": [
      "command", "exit_code", "tests_passed", "tests_total",
      "circuit_breaker_tested", "state_preservation_tested",
      "restart_policies_tested"
    ],
    "PROOF_SUPPORT_BUNDLE": [
      "command", "exit_code", "script_exists", "ui_handler_exists",
      "required_items_present", "items_checked"
    ],
    "PROOF_PERF_BUDGET": [
      "command", "exit_code", "budgets_defined", "budgets_values",
      "regression_detector_exists", "ci_mode_available"
    ],
    "PROOF_SUPPORT_BUNDLE_RUNTIME": [
      "command", "exit_code", "required_files",
      "ui_wiring_verified", "bundle_path_hash",
      "bundle_manifest_present", "crash_evidence_present"
    ],
    "PROOF_PERF_BUDGET_RUNTIME": [
      "command", "exit_code", "measured", "budgets",
      "within_budget", "environment", "panel_measurement_source"
    ],
    "PROOF_GOLDEN_PATH_STUB": [
      "command", "exit_code", "engine_mode", "checks",
      "output_metrics", "models", "passed",
      "test_ran", "pytest_stdout_sha256", "pytest_stderr_sha256",
      "artifact_path", "artifact_sha256"
    ],
    "PROOF_GOLDEN_PATH_REAL": [
      "command", "exit_code", "engine_mode", "checks",
      "output_metrics", "models", "passed",
      "test_ran", "pytest_stdout_sha256", "pytest_stderr_sha256",
      "artifact_path", "artifact_sha256"
    ]
  },
  "historical_proofs_allowlist_path": ".ci/historical_proofs_allowlist.json",
  "type_specific": {
    "PROOF_PHASE_3": {
      "override_common": false,
      "required": ["phase", "date", "checks"]
    },
    "PROOF_PHASE_2_1": {
      "override_common": false,
      "required": ["phase", "date", "checks"]
    },
    "PROOF_PROVENANCE": {
      "required": ["stdout", "stderr"]
    },
    "PROOF_GATE_C": {
      "required": ["ui_smoke", "gatec_log"]
    },
    "PROOF_INSTALLER": {
      "required": ["results", "all_passed"]
    },
    "PROOF_PAYLOAD_DETOX": {
      "required": ["check_repo_payloads", "policy_file_summary"]
    },
    "PROOF_GOLDEN_PATH": {
      "required": [
        "engine_mode", "model_hashes", "output_file_hash",
        "output_duration_seconds", "output_energy_rms", "all_steps_passed"
      ]
    },
    "PROOF_UI_COMMAND_SURFACE": {
      "required": [
        "commands_checked", "panels_checked",
        "all_commands_registered", "all_panels_registered",
        "command_details", "panel_details"
      ]
    },
    "PROOF_CRASH_RECOVERY": {
      "required": [
        "tests_passed", "tests_total",
        "circuit_breaker_tested", "state_preservation_tested",
        "restart_policies_tested"
      ]
    },
    "PROOF_SUPPORT_BUNDLE": {
      "required": [
        "script_exists", "ui_handler_exists",
        "required_items_present", "items_checked"
      ]
    },
    "PROOF_PERF_BUDGET": {
      "required": [
        "budgets_defined", "budgets_values",
        "regression_detector_exists", "ci_mode_available"
      ]
    },
    "PROOF_SUPPORT_BUNDLE_RUNTIME": {
      "required": [
        "required_files", "ui_wiring_verified", "bundle_path_hash",
        "bundle_manifest_present", "crash_evidence_present"
      ]
    },
    "PROOF_PERF_BUDGET_RUNTIME": {
      "required": [
        "measured", "budgets", "within_budget", "environment",
        "panel_measurement_source"
      ]
    },
    "PROOF_GOLDEN_PATH_STUB": {
      "required": [
        "engine_mode", "checks", "output_metrics",
        "models", "passed",
        "test_ran", "artifact_path", "artifact_sha256"
      ]
    },
    "PROOF_GOLDEN_PATH_REAL": {
      "required": [
        "engine_mode", "checks", "output_metrics",
        "models", "passed",
        "test_ran", "artifact_path", "artifact_sha256"
      ]
    },
    "PROOF_PHASE": {
      "override_common": true,
      "required": ["phase", "date", "checks"],
      "legacy_only": true
    }
  },
  "historical_proof_allowlist": [],
  "nested_semantics": {
    "PROOF_GATE_C": {
      "ui_smoke.exit_code": 0,
      "ui_smoke.nav_steps_completed_min": 8,
      "ui_smoke.binding_failure_count": 0,
      "ui_smoke.summary_sha256_hex": true,
      "ui_smoke.log_sha256_hex": true,
      "ui_smoke.summary_path_required": true,
      "ui_smoke.log_path_required": true
    },
    "PROOF_INSTALLER": {
      "results_required_keys": [
        "InstallV1",
        "LaunchV1",
        "UpgradeV1ToV2",
        "LaunchV2",
        "RollbackV2ToV1",
        "LaunchV1AfterRollback",
        "UninstallV1"
      ],
      "results_all_pass_when_all_passed_true": true
    },
    "PROOF_GOLDEN_PATH": {
      "engine_mode_enum": ["stub", "real"],
      "real_mode_constraints": {
        "output_duration_seconds_positive": true,
        "output_energy_rms_above": 0.001
      },
      "output_file_hash_sha256_hex": true,
      "all_steps_passed_must_be_true": true
    },
    "PROOF_UI_COMMAND_SURFACE": {
      "all_commands_registered_must_be_true": true,
      "all_panels_registered_must_be_true": true
    },
    "PROOF_CRASH_RECOVERY": {
      "tests_passed_equals_tests_total": true
    },
    "PROOF_SUPPORT_BUNDLE": {
      "script_exists_must_be_true": true,
      "ui_handler_exists_must_be_true": true,
      "required_items_present_must_be_true": true
    },
    "PROOF_PERF_BUDGET": {
      "budgets_defined_must_be_true": true,
      "regression_detector_exists_must_be_true": true
    },
    "PROOF_SUPPORT_BUNDLE_RUNTIME": {
      "ui_wiring_verified_must_be_true": true,
      "all_required_files_exist": true,
      "bundle_manifest_present_must_be_true": true,
      "crash_evidence_present_must_be_true": true,
      "bundle_path_hash_must_be_64_hex": true
    },
    "PROOF_PERF_BUDGET_RUNTIME": {
      "within_budget_must_be_true": true,
      "measured_values_positive": true,
      "environment_os_must_be_windows": true,
      "panel_measurement_source_required": true,
      "all_measured_within_budget": true
    },
    "PROOF_GOLDEN_PATH_STUB": {
      "passed_must_be_true": true,
      "engine_mode_must_be_stub": true,
      "output_metrics_positive": true,
      "test_ran_must_be_true": true,
      "artifact_sha256_required": true,
      "artifact_path_required": true
    },
    "PROOF_GOLDEN_PATH_REAL": {
      "passed_must_be_true": true,
      "engine_mode_must_be_real": true,
      "models_must_have_hashes": true,
      "output_metrics_positive": true,
      "test_ran_must_be_true": true,
      "artifact_sha256_required": true,
      "artifact_path_required": true
    }
  },
  "semantic_rules": {
    "exit_code_must_be_zero": true,
    "timestamp_iso8601": true,
    "git_commit_40_hex": true,
    "git_commit_matches_head_unless_historical": true
  }
}
