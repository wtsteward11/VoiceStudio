{
  "preset_id": "audiobook",
  "name": "Audiobook",
  "category": "audiobook",
  "description": "Clear, consistent narration optimized for long-form listening",
  "default_chain": {
    "schema_version": "1.0",
    "name": "Audiobook Pipeline",
    "steps": [
      {"step_id": "s1", "type": "synthesis", "parameters": {"temperature": 0.6, "speed": 1.0}},
      {"step_id": "s2", "type": "quality_evaluation"},
      {"step_id": "s3", "type": "post_processing", "parameters": {"preset": "audiobook_clean"}}
    ]
  },
  "default_quality_policy": {
    "min_mos": 4.0,
    "min_similarity": 0.85,
    "min_naturalness": 0.88,
    "max_artifact_score": 0.04,
    "min_snr_db": 32,
    "auto_enhance_if_below": true,
    "fail_if_unmet": false
  }
}
