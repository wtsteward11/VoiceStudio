<UserControl x:Class="VoiceStudio.App.Views.Panels.AdvancedSpectrogramVisualizationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:VoiceStudio.App.Controls"
    xmlns:local="using:VoiceStudio.App.Views.Panels"
    x:DataType="local:AdvancedSpectrogramVisualizationView">
    <Grid AutomationProperties.AutomationId="AdvancedSpectrogramVisualizationView_Root"
          Background="{StaticResource VSQ.Panel.Background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource VSQ.Panel.Background.HeaderBrush}"
                Padding="{StaticResource VSQ.Spacing.Medium}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE9D9;" FontSize="20"/>
                    <TextBlock Text="Advanced Spectrogram"
                               FontWeight="SemiBold"
                               FontSize="{StaticResource VSQ.FontSize.Title}"
                               Foreground="{StaticResource VSQ.Text.PrimaryBrush}"/>
                </StackPanel>
                <Button Grid.Column="1" Command="{x:Bind ViewModel.RefreshCommand}"
                        ToolTipService.ToolTip="Refresh"
                        AutomationProperties.AutomationId="AdvancedSpectrogramVisualizationView_RefreshButton">
                    <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                </Button>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="16" Spacing="12">

                <Border Background="{StaticResource VSQ.Panel.Background.DarkBrush}"
                        CornerRadius="{StaticResource VSQ.CornerRadius.Panel}" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Spectrogram Display" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource VSQ.Text.PrimaryBrush}"/>
                        <ComboBox ItemsSource="{x:Bind ViewModel.AvailableViewTypes, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedViewType, Mode=TwoWay}"
                                  PlaceholderText="View type" HorizontalAlignment="Stretch"
                                  AutomationProperties.AutomationId="AdvancedSpectrogramVisualizationView_ViewTypeComboBox"/>
                        <Border Height="300" CornerRadius="4" BorderThickness="1"
                                BorderBrush="{StaticResource VSQ.Panel.BorderBrush}">
                            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource VSQ.Text.SecondaryBrush}"/>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource VSQ.Panel.Background.DarkBrush}"
                        CornerRadius="{StaticResource VSQ.CornerRadius.Panel}" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Parameters" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource VSQ.Text.PrimaryBrush}"/>
                        <StackPanel Spacing="4">
                            <TextBlock Text="FFT Size" FontSize="11" Foreground="{StaticResource VSQ.Text.SecondaryBrush}"/>
                            <Slider Minimum="256" Maximum="8192" StepFrequency="256"
                                    Value="{x:Bind ViewModel.NFFT, Mode=TwoWay}"
                                    AutomationProperties.AutomationId="AdvancedSpectrogramVisualizationView_FftSlider"/>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Frequency Range (Hz)" FontSize="11" Foreground="{StaticResource VSQ.Text.SecondaryBrush}"/>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <NumberBox Header="Min" Value="{x:Bind ViewModel.FrequencyMin, Mode=TwoWay}"
                                           Minimum="0" Maximum="20000" SpinButtonPlacementMode="Compact"/>
                                <NumberBox Grid.Column="1" Header="Max" Value="{x:Bind ViewModel.FrequencyMax, Mode=TwoWay}"
                                           Minimum="0" Maximum="20000" SpinButtonPlacementMode="Compact"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" FontSize="12"
                           Foreground="OrangeRed"/>
            </StackPanel>
        </ScrollViewer>

        <controls:HelpOverlay x:Name="HelpOverlay" Grid.RowSpan="2" IsVisible="False" Visibility="Collapsed"/>
    </Grid>
</UserControl>
