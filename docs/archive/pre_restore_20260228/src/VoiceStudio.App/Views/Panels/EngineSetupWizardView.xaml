<UserControl
    x:Class="VoiceStudio.App.Views.Panels.EngineSetupWizardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VoiceStudio.App.Views.Panels">

    <Grid Padding="32" MaxWidth="700" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Step Indicator -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16" Margin="0,0,0,24">
            <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="12" Width="24" Height="24">
                <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="White"/>
            </Border>
            <TextBlock Text="Welcome" VerticalAlignment="Center" Opacity="{x:Bind local:EngineSetupWizardView.StepOpacity(ViewModel.CurrentStep, 0), Mode=OneWay}"/>
            <TextBlock Text=">" VerticalAlignment="Center" Opacity="0.4"/>
            <Border CornerRadius="12" Width="24" Height="24" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="2">
                <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
            </Border>
            <TextBlock Text="Select" VerticalAlignment="Center" Opacity="{x:Bind local:EngineSetupWizardView.StepOpacity(ViewModel.CurrentStep, 1), Mode=OneWay}"/>
            <TextBlock Text=">" VerticalAlignment="Center" Opacity="0.4"/>
            <Border CornerRadius="12" Width="24" Height="24" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="2">
                <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
            </Border>
            <TextBlock Text="Install" VerticalAlignment="Center" Opacity="{x:Bind local:EngineSetupWizardView.StepOpacity(ViewModel.CurrentStep, 2), Mode=OneWay}"/>
            <TextBlock Text=">" VerticalAlignment="Center" Opacity="0.4"/>
            <Border CornerRadius="12" Width="24" Height="24" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="2">
                <TextBlock Text="4" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
            </Border>
            <TextBlock Text="Done" VerticalAlignment="Center" Opacity="{x:Bind local:EngineSetupWizardView.StepOpacity(ViewModel.CurrentStep, 3), Mode=OneWay}"/>
        </StackPanel>

        <!-- Step Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">

                <!-- Step 0: Welcome -->
                <StackPanel Visibility="{x:Bind local:EngineSetupWizardView.StepVisible(ViewModel.CurrentStep, 0), Mode=OneWay}" Spacing="12">
                    <TextBlock Text="Welcome to VoiceStudio" Style="{ThemeResource TitleTextBlockStyle}"/>
                    <TextBlock TextWrapping="Wrap" Opacity="0.8"
                        Text="VoiceStudio needs at least one voice engine to synthesize speech, clone voices, and process audio. This wizard will help you install your first engine in a few minutes."/>

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16" Margin="0,8,0,0">
                        <StackPanel Spacing="8">
                            <TextBlock Text="System Information" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE7F4;" FontSize="16"/>
                                <TextBlock Text="{x:Bind ViewModel.GpuName, Mode=OneWay}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xEDA2;" FontSize="16"/>
                                <TextBlock Text="{x:Bind ViewModel.RamInfo, Mode=OneWay}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Step 1: Engine Selection -->
                <StackPanel Visibility="{x:Bind local:EngineSetupWizardView.StepVisible(ViewModel.CurrentStep, 1), Mode=OneWay}" Spacing="12">
                    <TextBlock Text="Choose an Engine" Style="{ThemeResource TitleTextBlockStyle}"/>
                    <TextBlock TextWrapping="Wrap" Opacity="0.8"
                        Text="Select a voice engine to install. XTTS v2 is recommended for the best experience with voice cloning."/>

                    <ListView ItemsSource="{x:Bind ViewModel.AvailableEngines}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:EngineOption">
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16" Margin="0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="16"/>
                                                <Border Visibility="{x:Bind local:EngineSetupWizardView.BoolToVisible(IsRecommended)}"
                                                    Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="Recommended" FontSize="10" Foreground="White"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" Opacity="0.7" FontSize="13"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Select" VerticalAlignment="Center"
                                            Click="SelectEngine_Click" Tag="{x:Bind Id}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock Margin="0,8,0,0" FontSize="13" Opacity="0.6">
                        <Run Text="Selected: "/>
                        <Run Text="{x:Bind ViewModel.SelectedEngineName, Mode=OneWay}" FontWeight="SemiBold"/>
                    </TextBlock>
                </StackPanel>

                <!-- Step 2: Installation -->
                <StackPanel Visibility="{x:Bind local:EngineSetupWizardView.StepVisible(ViewModel.CurrentStep, 2), Mode=OneWay}" Spacing="12">
                    <TextBlock Text="Installing Engine" Style="{ThemeResource TitleTextBlockStyle}"/>

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock FontWeight="SemiBold">
                                <Run Text="Engine: "/>
                                <Run Text="{x:Bind ViewModel.SelectedEngineName, Mode=OneWay}"/>
                            </TextBlock>

                            <ProgressBar Value="{x:Bind ViewModel.InstallProgress, Mode=OneWay}"
                                IsIndeterminate="{x:Bind ViewModel.IsInstalling, Mode=OneWay}"
                                Maximum="100"/>

                            <TextBlock Text="{x:Bind ViewModel.InstallStage, Mode=OneWay}" Opacity="0.7"/>

                            <TextBlock Text="{x:Bind ViewModel.ErrorDetails, Mode=OneWay}"
                                Visibility="{x:Bind local:EngineSetupWizardView.StringToVisible(ViewModel.ErrorDetails), Mode=OneWay}"
                                Foreground="Red" TextWrapping="Wrap" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <Button Content="Install Now" HorizontalAlignment="Center"
                        Style="{ThemeResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.InstallEngineCommand}"
                        IsEnabled="{x:Bind local:EngineSetupWizardView.NotBool(ViewModel.IsInstalling), Mode=OneWay}"/>
                </StackPanel>

                <!-- Step 3: Complete -->
                <StackPanel Visibility="{x:Bind local:EngineSetupWizardView.StepVisible(ViewModel.CurrentStep, 3), Mode=OneWay}" Spacing="12">
                    <TextBlock Text="Setup Complete" Style="{ThemeResource TitleTextBlockStyle}"/>

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="24">
                        <StackPanel Spacing="12" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE73E;" FontSize="48" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                TextAlignment="Center" FontSize="16" TextWrapping="Wrap"/>
                            <TextBlock TextAlignment="Center" Opacity="0.7" TextWrapping="Wrap"
                                Text="You can now use voice synthesis, cloning, and audio processing. More engines can be installed from Settings."/>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Navigation Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
            <Button Content="Back" Command="{x:Bind ViewModel.PreviousStepCommand}"
                Visibility="{x:Bind local:EngineSetupWizardView.NotStepZeroVisible(ViewModel.CurrentStep), Mode=OneWay}"/>
            <Button Content="Next" Style="{ThemeResource AccentButtonStyle}"
                Command="{x:Bind ViewModel.NextStepCommand}"
                Visibility="{x:Bind local:EngineSetupWizardView.NotLastStepVisible(ViewModel.CurrentStep), Mode=OneWay}"/>
            <Button Content="Skip Setup" Click="SkipSetup_Click" Opacity="0.6"
                Visibility="{x:Bind local:EngineSetupWizardView.StepVisible(ViewModel.CurrentStep, 0), Mode=OneWay}"/>
        </StackPanel>
    </Grid>
</UserControl>
