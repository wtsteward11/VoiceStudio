{
  "$schema": "../../../shared/schemas/engine.manifest.schema.json",
  "engine_id": "coqui_tts",
  "name": "Coqui TTS",
  "type": "audio",
  "subtype": "tts",
  "version": "0.22.0",
  "description": "Multi-model TTS library with 100+ pretrained models and voice cloning support",
  "author": "Coqui AI",
  "license": "MPL-2.0",
  "homepage": "https://github.com/coqui-ai/TTS",
  "dependencies": {
    "python": ">=3.10,<3.12",
    "TTS": ">=0.22.0",
    "torch": ">=2.0.0",
    "torchaudio": ">=2.0.0"
  },
  "capabilities": [
    "multi_language_tts",
    "zero_shot_cloning",
    "emotion_control",
    "streaming",
    "high_quality_synthesis",
    "style_transfer"
  ],
  "languages": ["en", "es", "fr", "de", "it", "pt", "ru", "ja", "ko", "zh", "ar", "hi", "nl", "pl", "tr", "uk", "vi"],
  "model_paths": {
    "base": "%PROGRAMDATA%/VoiceStudio/models/coqui_tts",
    "cache": "%PROGRAMDATA%/VoiceStudio/models/coqui_tts/cache"
  },
  "entry_point": "app.core.engines.tts.coqui_engine.CoquiTTSEngine",
  "config_schema": {
    "model_name": {
      "type": "string",
      "default": "tts_models/en/ljspeech/tacotron2-DDC",
      "description": "Coqui TTS model identifier"
    },
    "speaker": {
      "type": "string",
      "default": "",
      "description": "Speaker name for multi-speaker models"
    },
    "language": {
      "type": "string",
      "default": "en",
      "description": "Target language for multilingual models"
    },
    "speaker_wav": {
      "type": "string",
      "default": "",
      "description": "Path to reference audio for voice cloning"
    },
    "emotion": {
      "type": "string",
      "enum": ["neutral", "happy", "sad", "angry", "surprised"],
      "default": "neutral",
      "description": "Emotion for emotion-capable models"
    },
    "speed": {
      "type": "number",
      "default": 1.0,
      "minimum": 0.5,
      "maximum": 2.0,
      "description": "Speech speed"
    }
  },
  "status": "stable",
  "quality_rating": 8,
  "speed_rating": 7,
  "recommended_for": ["general_tts", "multilingual", "model_exploration"]
}
