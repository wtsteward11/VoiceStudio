{
  "$schema": "../../../shared/schemas/engine.manifest.schema.json",
  "engine_id": "styletts2",
  "name": "StyleTTS 2",
  "type": "audio",
  "subtype": "tts",
  "version": "2.0.0",
  "description": "State-of-the-art TTS achieving human-level naturalness with style diffusion",
  "author": "yl4579",
  "license": "MIT",
  "homepage": "https://github.com/yl4579/StyleTTS2",
  "dependencies": {
    "python": ">=3.10,<3.12",
    "torch": ">=2.0.0",
    "torchaudio": ">=2.0.0",
    "phonemizer": ">=3.2.0"
  },
  "capabilities": [
    "high_quality_synthesis",
    "zero_shot_cloning",
    "style_transfer",
    "emotion_control",
    "expressive_speech"
  ],
  "languages": ["en"],
  "model_paths": {
    "base": "%PROGRAMDATA%/VoiceStudio/models/styletts2"
  },
  "entry_point": "app.core.engines.tts.styletts2_engine.StyleTTS2Engine",
  "config_schema": {
    "diffusion_steps": {
      "type": "integer",
      "default": 5,
      "minimum": 1,
      "maximum": 20,
      "description": "Number of diffusion steps (more = better quality, slower)"
    },
    "embedding_scale": {
      "type": "number",
      "default": 1.0,
      "minimum": 0.0,
      "maximum": 2.0,
      "description": "Style embedding strength"
    },
    "alpha": {
      "type": "number",
      "default": 0.3,
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Prosody interpolation"
    },
    "beta": {
      "type": "number",
      "default": 0.7,
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Style interpolation"
    },
    "noise_scale": {
      "type": "number",
      "default": 0.667,
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Variation/expressiveness"
    }
  },
  "status": "stable",
  "quality_rating": 10,
  "speed_rating": 5,
  "recommended_for": ["highest_quality", "audiobook", "professional_voiceover"]
}
