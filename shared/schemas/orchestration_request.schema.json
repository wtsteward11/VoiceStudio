{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "orchestration_request.schema.json",
  "title": "OrchestrationRequest",
  "description": "Primary input contract for the orchestration API",
  "type": "object",
  "properties": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50000
    },
    "voice_profile_id": {
      "type": "string",
      "minLength": 1
    },
    "reference_audio_path": {
      "type": ["string", "null"]
    },
    "language": {
      "type": "string",
      "default": "en"
    },
    "production_chain": {
      "oneOf": [
        { "$ref": "production_chain.schema.json" },
        { "type": "null" }
      ]
    },
    "strategy": {
      "type": "string",
      "enum": ["auto", "quality_first", "speed_first", "deterministic"],
      "default": "auto"
    },
    "target_quality": {
      "$ref": "quality_threshold_policy.schema.json"
    },
    "retry_policy": {
      "type": "object",
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 3
        },
        "adaptive_adjustment": {
          "type": "boolean",
          "default": true
        },
        "fallback_engines_enabled": {
          "type": "boolean",
          "default": true
        },
        "parameter_mutation_strategy": {
          "type": "string",
          "enum": ["none", "random_variation", "quality_gradient"],
          "default": "quality_gradient"
        }
      }
    },
    "async_mode": {
      "type": "boolean",
      "default": true
    },
    "priority": {
      "type": "string",
      "enum": ["realtime", "interactive", "batch"],
      "default": "interactive"
    }
  },
  "required": ["text", "voice_profile_id"]
}
