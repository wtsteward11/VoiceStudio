{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "strategy_preset.schema.json",
  "title": "StrategyPreset",
  "description": "Saved orchestration template combining chain and quality policy",
  "type": "object",
  "properties": {
    "preset_id": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "enum": ["cinematic", "audiobook", "podcast", "broadcast", "game_character", "conversational"]
    },
    "default_chain": {
      "$ref": "production_chain.schema.json"
    },
    "default_quality_policy": {
      "$ref": "quality_threshold_policy.schema.json"
    },
    "description": {
      "type": "string"
    },
    "is_builtin": {
      "type": "boolean",
      "default": false
    }
  },
  "required": ["name", "category"]
}
