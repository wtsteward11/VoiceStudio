<UserControl x:Class="VoiceStudio.App.Controls.ErrorOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:VoiceStudio.App.Converters"
    xmlns:local="using:VoiceStudio.App.Controls"
    x:DataType="local:ErrorOverlay">
    <UserControl.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
    </UserControl.Resources>
    <Grid x:Name="ErrorGrid" Background="{StaticResource VSQ.Loading.BackgroundBrush}"
          Visibility="{x:Bind ErrorMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}"
          AutomationProperties.AutomationId="ErrorOverlay_Root">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" MaxWidth="320">
            <FontIcon Glyph="&#xE783;" FontFamily="Segoe Fluent Icons" FontSize="32" Opacity="0.6"
                      HorizontalAlignment="Center" />
            <TextBlock Text="{x:Bind ErrorTitle, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock Text="{x:Bind ErrorMessage, Mode=OneWay}" FontSize="13" Opacity="0.85"
                       TextAlignment="Center" TextWrapping="Wrap" />
            <Button x:Name="RetryButton" Content="Retry" HorizontalAlignment="Center"
                    Click="RetryButton_Click" Style="{StaticResource VSQ.Button.FocusStyle}"
                    AutomationProperties.AutomationId="ErrorOverlay_RetryButton" />
        </StackPanel>
    </Grid>
</UserControl>
