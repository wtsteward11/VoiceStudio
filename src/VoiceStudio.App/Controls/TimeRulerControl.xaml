<UserControl x:Class="VoiceStudio.App.Controls.TimeRulerControl"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
  xmlns:local="using:VoiceStudio.App.Controls"
  x:DataType="local:TimeRulerControl">
  <Border x:Name="RulerBorder" Height="24"
          Background="{StaticResource VSQ.Panel.Background.DarkerBrush}"
          BorderBrush="{StaticResource VSQ.Panel.BorderBrush}"
          BorderThickness="0,0,0,1">
    <canvas:CanvasControl x:Name="RulerCanvas"
                          Draw="RulerCanvas_Draw"
                          SizeChanged="RulerCanvas_SizeChanged"
                          ClearColor="Transparent" />
  </Border>
</UserControl>
