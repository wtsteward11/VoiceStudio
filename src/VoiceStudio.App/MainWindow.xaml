<Window x:Class="VoiceStudio.App.MainWindow"
  Title="VoiceStudio Quantum+"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="using:VoiceStudio.App.Controls"
  xmlns:views="using:VoiceStudio.App.Views"
  xmlns:services="using:VoiceStudio.App.Services">
  <Grid Background="{StaticResource VSQ.Window.Background}" x:Name="RootGrid"
        MinWidth="{StaticResource VSQ.Shell.MinWidth}"
        MinHeight="{StaticResource VSQ.Shell.MinHeight}">
    <Grid.RowDefinitions>
      <RowDefinition Height="32" />
      <!-- Custom title bar (drag region + chrome; system caption replaced when ExtendsContentIntoTitleBar) -->
      <RowDefinition Height="Auto" />
      <!-- Menu bar -->
      <RowDefinition Height="48" />
      <!-- Toolbar -->
      <RowDefinition Height="Auto" />
      <!-- Global transport strip -->
      <RowDefinition Height="*" />
      <!-- Workspace -->
      <RowDefinition Height="Auto" />
      <!-- Degraded mode banner (rate-limit/backend stress) -->
      <RowDefinition Height="26" />
      <!-- Status bar -->
    </Grid.RowDefinitions>
    <!-- Custom title bar: icon + title + drag surface (SetTitleBar target) -->
    <Grid Grid.Row="0" x:Name="TitleBarChromeGrid" Height="32" Padding="12,0,8,0" VerticalAlignment="Stretch"
      Background="Transparent">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <FontIcon Grid.Column="0" Glyph="&#xE700;" FontSize="16" FontFamily="Segoe Fluent Icons"
        VerticalAlignment="Center"
        AutomationProperties.AutomationId="MainWindow_TitleBarIcon" />
      <TextBlock Grid.Column="1" Text="VoiceStudio Quantum+" VerticalAlignment="Center" Margin="8,0,12,0"
        Style="{StaticResource VSQ.Text.Body}"
        AutomationProperties.AutomationId="MainWindow_TitleBarText" />
      <Border x:Name="AppTitleBar" Grid.Column="2" Background="Transparent" VerticalAlignment="Stretch"
        AutomationProperties.AutomationId="MainWindow_AppTitleBarDragRegion" />
      <Button x:Name="NotificationCenterButton" Grid.Column="3" Width="32" Height="28" Padding="0"
        VerticalAlignment="Center" Margin="4,0,0,0"
        ToolTipService.ToolTip="Notification Center"
        Style="{StaticResource VSQ.Button.NavToggle}"
        AutomationProperties.AutomationId="MainWindow_NotificationCenterButton">
        <Grid>
          <FontIcon Glyph="&#xEA8F;" FontSize="16" FontFamily="Segoe Fluent Icons" />
          <Border x:Name="UnreadBadge"
            AutomationProperties.AutomationId="MainWindow_NotificationCenterUnreadBadge"
            Width="14" Height="14" CornerRadius="7"
            Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,2,0"
            Visibility="Collapsed">
            <TextBlock x:Name="UnreadBadgeText" FontSize="9" HorizontalAlignment="Center"
              VerticalAlignment="Center" />
          </Border>
        </Grid>
        <Button.Flyout>
          <Flyout x:Name="NotificationCenterFlyout"
            AutomationProperties.AutomationId="MainWindow_NotificationCenterFlyout"
            Placement="Bottom">
            <Grid x:Name="NotificationCenterFlyoutRoot" Width="360" MaxHeight="480">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Grid Grid.Row="0" Padding="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Notifications" Style="{StaticResource VSQ.Text.Subtitle}"
                  VerticalAlignment="Center" />
                <Button x:Name="NotificationCenterMarkAllReadButton" Grid.Column="1"
                  Content="Mark all read"
                  AutomationProperties.AutomationId="MainWindow_NotificationCenterMarkAllRead"
                  Click="NotificationCenterMarkAllRead_Click" />
              </Grid>
              <ListView x:Name="NotificationCenterList" Grid.Row="1"
                AutomationProperties.AutomationId="MainWindow_NotificationCenterList"
                SelectionMode="None">
                <ListView.ItemTemplate>
                  <DataTemplate x:DataType="services:AppNotificationItem">
                    <Grid Padding="0,4" ColumnSpacing="8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0" Orientation="Vertical" Spacing="2">
                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="WrapWholeWords" />
                        <TextBlock Text="{x:Bind Message}" TextWrapping="WrapWholeWords"
                          Style="{StaticResource VSQ.Text.Caption}" />
                        <TextBlock Text="{x:Bind CreatedAt}" Style="{StaticResource VSQ.Text.Caption}" />
                      </StackPanel>
                      <Button Grid.Column="1" Content="Dismiss" VerticalAlignment="Top"
                        AutomationProperties.AutomationId="MainWindow_NotificationCenterDismissItem"
                        Click="NotificationCenterDismissItem_Click" />
                    </Grid>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
            </Grid>
          </Flyout>
        </Button.Flyout>
      </Button>
    </Grid>
    <!-- Menu bar host (populated by InitializeMenuBar) -->
    <ContentControl x:Name="MenuBarHost" Grid.Row="1" HorizontalAlignment="Stretch" Margin="8,2,8,0" />
    <!-- Top command toolbar -->
    <controls:CustomizableToolbar Grid.Row="2" Margin="8,0,8,4" x:Name="CommandToolbar" />
    <!-- Global transport strip: current media, source, status -->
    <Border Grid.Row="3" Height="28" Margin="8,0,8,2" Padding="8,0"
      Background="{StaticResource VSQ.Panel.Background.DarkBrush}"
      BorderBrush="{StaticResource VSQ.Panel.BorderBrush}" BorderThickness="0,0,0,1"
      CornerRadius="4,4,0,0">
      <controls:GlobalTransportControl x:Name="GlobalTransportControl" />
    </Border>
    <!-- Main workspace -->
    <Grid Grid.Row="4" Margin="8,0,8,4" x:Name="WorkspaceGrid"
      AutomationProperties.AutomationId="MainWindow_WorkspaceGrid">
      <Grid.RowDefinitions>
        <RowDefinition x:Name="TopRow" Height="4*" />
        <RowDefinition Height="4" />
        <RowDefinition x:Name="BottomRow" Height="*" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="64" />
        <ColumnDefinition x:Name="LeftColumn" Width="20*" />
        <ColumnDefinition Width="4" />
        <ColumnDefinition x:Name="CenterColumn" Width="55*" />
        <ColumnDefinition Width="4" />
        <ColumnDefinition x:Name="RightColumn" Width="25*" />
      </Grid.ColumnDefinitions>
      <!-- Nav rail - DataContext set to NavigationViewModel in code-behind -->
      <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" x:Name="NavRailBorder"
        Background="{StaticResource VSQ.NavRail.BackgroundBrush}"
        CornerRadius="{StaticResource VSQ.CornerRadius.Panel}"
        Padding="{StaticResource VSQ.Spacing.Small}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,8"
          Spacing="4">
          <ToggleButton x:Name="NavStudio" ToolTipService.ToolTip="Studio" Width="44"
            Height="44" Style="{StaticResource VSQ.Button.NavToggle}"
            AutomationProperties.AutomationId="NavStudio"
            Command="{Binding NavigateToStudioCommand}"
            IsChecked="{Binding IsStudioActive, Mode=OneWay}"
            PointerEntered="NavButton_PointerEntered" PointerExited="NavButton_PointerExited">
            <FontIcon Glyph="&#xE80F;" FontSize="18" FontFamily="Segoe Fluent Icons" />
          </ToggleButton>
          <ToggleButton x:Name="NavProfiles" ToolTipService.ToolTip="Profiles" Width="44"
            Height="44" Style="{StaticResource VSQ.Button.NavToggle}"
            AutomationProperties.AutomationId="NavProfiles"
            Command="{Binding NavigateToProfilesCommand}"
            IsChecked="{Binding IsProfilesActive, Mode=OneWay}"
            PointerEntered="NavButton_PointerEntered" PointerExited="NavButton_PointerExited">
            <FontIcon Glyph="&#xE77B;" FontSize="18" FontFamily="Segoe Fluent Icons" />
          </ToggleButton>
          <ToggleButton x:Name="NavLibrary" ToolTipService.ToolTip="Library" Width="44"
            Height="44" Style="{StaticResource VSQ.Button.NavToggle}"
            AutomationProperties.AutomationId="NavLibrary"
            Command="{Binding NavigateToLibraryCommand}"
            IsChecked="{Binding IsLibraryActive, Mode=OneWay}"
            PointerEntered="NavButton_PointerEntered" PointerExited="NavButton_PointerExited">
            <FontIcon Glyph="&#xE8F1;" FontSize="18" FontFamily="Segoe Fluent Icons" />
          </ToggleButton>
          <ToggleButton x:Name="NavEffects" ToolTipService.ToolTip="Effects" Width="44"
            Height="44" Style="{StaticResource VSQ.Button.NavToggle}"
            AutomationProperties.AutomationId="NavEffects"
            Command="{Binding NavigateToEffectsCommand}"
            IsChecked="{Binding IsEffectsActive, Mode=OneWay}"
            PointerEntered="NavButton_PointerEntered" PointerExited="NavButton_PointerExited">
            <FontIcon Glyph="&#xE9D9;" FontSize="18" FontFamily="Segoe Fluent Icons" />
          </ToggleButton>
          <ToggleButton x:Name="NavTrain" ToolTipService.ToolTip="Train" Width="44"
            Height="44" Style="{StaticResource VSQ.Button.NavToggle}"
            AutomationProperties.AutomationId="NavTrain"
            Command="{Binding NavigateToTrainCommand}"
            IsChecked="{Binding IsTrainActive, Mode=OneWay}"
            PointerEntered="NavButton_PointerEntered" PointerExited="NavButton_PointerExited">
            <FontIcon Glyph="&#xE7BE;" FontSize="18" FontFamily="Segoe Fluent Icons" />
          </ToggleButton>
          <ToggleButton x:Name="NavAnalyze" ToolTipService.ToolTip="Analyze" Width="44"
            Height="44" Style="{StaticResource VSQ.Button.NavToggle}"
            AutomationProperties.AutomationId="NavAnalyze"
            Command="{Binding NavigateToAnalyzeCommand}"
            IsChecked="{Binding IsAnalyzeActive, Mode=OneWay}"
            PointerEntered="NavButton_PointerEntered" PointerExited="NavButton_PointerExited">
            <FontIcon Glyph="&#xE9D9;" FontSize="18" FontFamily="Segoe Fluent Icons" />
          </ToggleButton>
          <!-- Separator between creative tools and utility tools -->
          <Rectangle Width="32" Height="1" Fill="{StaticResource VSQ.Panel.BorderBrush}" Margin="0,4,0,4" />
          <ToggleButton x:Name="NavSettings" ToolTipService.ToolTip="Settings" Width="44"
            Height="44" Style="{StaticResource VSQ.Button.NavToggle}"
            AutomationProperties.AutomationId="NavSettings"
            Command="{Binding NavigateToSettingsCommand}"
            IsChecked="{Binding IsSettingsActive, Mode=OneWay}"
            PointerEntered="NavButton_PointerEntered" PointerExited="NavButton_PointerExited">
            <FontIcon Glyph="&#xE713;" FontSize="18" FontFamily="Segoe Fluent Icons" />
          </ToggleButton>
          <ToggleButton x:Name="NavLogs" ToolTipService.ToolTip="Diagnostics" Width="44"
            Height="44" Style="{StaticResource VSQ.Button.NavToggle}"
            AutomationProperties.AutomationId="NavLogs"
            Command="{Binding NavigateToLogsCommand}"
            IsChecked="{Binding IsLogsActive, Mode=OneWay}"
            PointerEntered="NavButton_PointerEntered" PointerExited="NavButton_PointerExited">
            <FontIcon Glyph="&#xE7BA;" FontSize="18" FontFamily="Segoe Fluent Icons" />
          </ToggleButton>
        </StackPanel>
      </Border>
      <!-- Left / Center / Right PanelHosts -->
      <controls:PanelHost Grid.Row="0" Grid.Column="1" Margin="4,0,4,4" x:Name="LeftPanelHost"
        AutomationProperties.AutomationId="MainWindow_LeftPanelHost" />
      <controls:PanelHost Grid.Row="0" Grid.Column="3" Margin="0,0,4,4" x:Name="CenterPanelHost"
        AutomationProperties.AutomationId="MainWindow_CenterPanelHost" />
      <controls:PanelHost Grid.Row="0" Grid.Column="5" Margin="0,0,0,4" x:Name="RightPanelHost" />
      <!-- Vertical splitter gutters (resizable via pointer drag - see MainWindow.xaml.cs) -->
      <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="2" Width="4"
        Background="{StaticResource VSQ.Panel.BorderBrush}" x:Name="VerticalSplitter1"
        PointerPressed="WorkspaceSplitter_PointerPressed" PointerMoved="WorkspaceSplitter_PointerMoved"
        PointerReleased="WorkspaceSplitter_PointerReleased" PointerCanceled="WorkspaceSplitter_PointerReleased"
        HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
      <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="4" Width="4"
        Background="{StaticResource VSQ.Panel.BorderBrush}" x:Name="VerticalSplitter2"
        PointerPressed="WorkspaceSplitter_PointerPressed" PointerMoved="WorkspaceSplitter_PointerMoved"
        PointerReleased="WorkspaceSplitter_PointerReleased" PointerCanceled="WorkspaceSplitter_PointerReleased"
        HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
      <!-- Horizontal splitter gutter -->
      <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="5" Height="4"
        Background="{StaticResource VSQ.Panel.BorderBrush}" x:Name="HorizontalSplitter"
        PointerPressed="WorkspaceSplitter_PointerPressed" PointerMoved="WorkspaceSplitter_PointerMoved"
        PointerReleased="WorkspaceSplitter_PointerReleased" PointerCanceled="WorkspaceSplitter_PointerReleased"
        HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
      <!-- Bottom PanelHost -->
      <controls:PanelHost Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="5" x:Name="BottomPanelHost" />
    </Grid>
    <!-- Degraded mode banner (429/backend stress) -->
    <InfoBar x:Name="DegradedModeBanner" Grid.Row="5" IsOpen="False" IsClosable="True"
      Severity="Warning" Margin="8,4,8,0"
      AutomationProperties.AutomationId="MainWindow_DegradedModeBanner" />
    <!-- Status bar -->
    <Border Grid.Row="6" Height="26" Background="{StaticResource VSQ.StatusBar.BackgroundBrush}"
      BorderBrush="{StaticResource VSQ.Panel.BorderBrush}" BorderThickness="1,1,1,0">
      <Grid Margin="8,0,8,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
          Spacing="{StaticResource VSQ.Spacing.Value.Medium}"
          Margin="0,0,12,0">
          <Border x:Name="ProcessingIndicator" Width="8" Height="8"
            CornerRadius="{StaticResource VSQ.CornerRadius.Small}"
            Background="{StaticResource VSQ.StatusIndicator.IdleBrush}"
            AutomationProperties.AutomationId="StatusBar_ProcessingIndicator"
            ToolTipService.ToolTip="Processing: Idle">
          </Border>
          <Border x:Name="NetworkIndicator" Width="8" Height="8"
            CornerRadius="{StaticResource VSQ.CornerRadius.Small}"
            Background="{StaticResource VSQ.StatusIndicator.SuccessBrush}"
            ToolTipService.ToolTip="Network: Connected">
          </Border>
          <Border x:Name="EngineIndicator" Width="8" Height="8"
            CornerRadius="{StaticResource VSQ.CornerRadius.Small}"
            Background="{StaticResource VSQ.StatusIndicator.SuccessBrush}"
            ToolTipService.ToolTip="Engine: Starting…">
          </Border>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
          <TextBlock x:Name="StatusText" Text="Starting…" AutomationProperties.AutomationId="StatusBar_StatusText" />
          <TextBlock x:Name="CurrentMediaStatusText" Text="" FontSize="10"
            Foreground="{StaticResource VSQ.Text.SecondaryBrush}"
            AutomationProperties.AutomationId="StatusBar_CurrentMedia" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
          HorizontalAlignment="Center">
          <TextBlock Text="Job:" Margin="0,0,4,0" />
          <TextBlock x:Name="JobStatusText" Text="Idle"
            AutomationProperties.AutomationId="StatusBar_JobStatusText" />
          <ProgressBar x:Name="JobProgressBar" Width="200" Height="6" Margin="12,0,0,0" Value="0"
            AutomationProperties.AutomationId="StatusBar_JobProgressBar" />
        </StackPanel>
        <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right"
          VerticalAlignment="Center" Spacing="4">
          <TextBlock x:Name="CpuText" Text="CPU 0%" FontSize="10" Foreground="{StaticResource VSQ.Text.SecondaryBrush}" />
          <TextBlock x:Name="GpuText" Text="GPU 0%" FontSize="10" Foreground="{StaticResource VSQ.Text.SecondaryBrush}" />
          <TextBlock x:Name="RamText" Text="RAM 0%" FontSize="10" Foreground="{StaticResource VSQ.Text.SecondaryBrush}" />
          <Rectangle Width="1" Height="12" Fill="{StaticResource VSQ.Panel.BorderBrush}" Margin="4,0" />
          <TextBlock x:Name="SampleRateText" Text="48 kHz" FontSize="10" Foreground="{StaticResource VSQ.Accent.CyanBrush}" />
          <TextBlock x:Name="LatencyText" Text="--ms" FontSize="10" Foreground="{StaticResource VSQ.Text.SecondaryBrush}" />
          <Rectangle Width="1" Height="12" Fill="{StaticResource VSQ.Panel.BorderBrush}" Margin="4,0" />
          <Button x:Name="CollaboratorsToggleButton" ToolTipService.ToolTip="Show Collaborators"
            Click="CollaboratorsToggleButton_Click" Padding="2" Background="Transparent" BorderThickness="0">
            <FontIcon Glyph="&#xE716;" FontSize="12" FontFamily="Segoe Fluent Icons" />
          </Button>
          <Rectangle Width="1" Height="12" Fill="{StaticResource VSQ.Panel.BorderBrush}" Margin="4,0" />
          <TextBlock x:Name="ClockText" Text="00:00" FontSize="10" Foreground="{StaticResource VSQ.Text.SecondaryBrush}" />
        </StackPanel>
      </Grid>
    </Border>
    <!-- Toast Notification Container (IDEA 11) -->
    <StackPanel x:Name="ToastContainer" Grid.Row="4" HorizontalAlignment="Right"
      VerticalAlignment="Bottom" Margin="0,0,16,80" Spacing="0" MaxWidth="400" />
    <!-- Global Search Overlay (IDEA 5) -->
    <Grid x:Name="GlobalSearchOverlay" Grid.Row="4"
      Background="{StaticResource VSQ.Overlay.BackgroundBrush}" Visibility="Collapsed"
      Tapped="GlobalSearchOverlay_Tapped">
      <views:GlobalSearchView x:Name="GlobalSearchView" HorizontalAlignment="Center"
        VerticalAlignment="Top" Margin="0,100,0,0" />
    </Grid>
    <!-- Collaboration Indicators (IDEA 25) -->
    <Border x:Name="CollaborationPanel" Grid.Row="4" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0"
      Background="{StaticResource VSQ.Panel.Background.DarkBrush}"
      BorderBrush="{StaticResource VSQ.Panel.BorderBrush}" BorderThickness="1" CornerRadius="8"
      Padding="8" Width="280" MaxHeight="400" Visibility="Collapsed">
      <controls:CollaborationIndicator x:Name="CollaborationIndicator" CloseRequested="CollaborationIndicator_CloseRequested" />
    </Border>
    <!-- Startup overlay: visible by default until backend ready (Task 3: show before content) -->
    <Border x:Name="StartupOverlay" Grid.Row="0" Grid.RowSpan="7"
      Background="{StaticResource VSQ.Overlay.BackgroundBrush}"
      Visibility="Visible"
      AutomationProperties.AutomationId="MainWindow_StartupOverlay">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
        <ProgressRing x:Name="StartupProgressRing" IsActive="True" Width="48" Height="48" />
        <TextBlock x:Name="StartupOverlayMessage" Text="Starting VoiceStudio services…"
          FontSize="16" HorizontalAlignment="Center" />
        <Button x:Name="StartupRetryButton" Content="Retry" Visibility="Collapsed"
          AutomationProperties.AutomationId="StartupOverlay_RetryButton"
          Click="StartupRetryButton_Click" />
      </StackPanel>
    </Border>
  </Grid>
</Window>