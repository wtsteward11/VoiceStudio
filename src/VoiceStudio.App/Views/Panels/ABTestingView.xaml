<UserControl x:Class="VoiceStudio.App.Views.Panels.ABTestingView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="using:VoiceStudio.App.Controls"
  xmlns:local="using:VoiceStudio.App.Views.Panels"
  x:DataType="local:ABTestingView">
  <Grid AutomationProperties.AutomationId="ABTestingView_Root"
        Background="{StaticResource VSQ.Panel.Background}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Background="{StaticResource VSQ.Panel.Background.HeaderBrush}"
            Padding="{StaticResource VSQ.Spacing.Medium}">
      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="A/B Testing"
                   FontSize="{StaticResource VSQ.FontSize.Title}"
                   Foreground="{StaticResource VSQ.Text.PrimaryBrush}" />
        <Button Grid.Column="1"
                Content="Help"
                Click="HelpButton_Click"
                AutomationProperties.AutomationId="ABTestingView_HelpButton" />
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="{StaticResource VSQ.Spacing.Medium}">
      <StackPanel Spacing="16" MaxWidth="920">
        <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                 Severity="Error"
                 Title="A/B testing"
                 Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                 AutomationProperties.AutomationId="ABTestingView_ErrorInfoBar" />

        <TextBlock Text="Profile" FontWeight="SemiBold" />
        <ComboBox ItemsSource="{x:Bind ViewModel.Profiles, Mode=OneWay}"
                  SelectedItem="{x:Bind ViewModel.SelectedProfile, Mode=TwoWay}"
                  DisplayMemberPath="Name"
                  PlaceholderText="Select a voice profile"
                  MinWidth="280"
                  HorizontalAlignment="Left"
                  AutomationProperties.AutomationId="ABTestingView_ProfileComboBox" />

        <TextBlock Text="Test text" FontWeight="SemiBold" />
        <TextBox Text="{x:Bind ViewModel.TestText, Mode=TwoWay}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 MinHeight="80"
                 AutomationProperties.AutomationId="ABTestingView_TestTextBox" />

        <TextBlock Text="Engine A" FontWeight="SemiBold" />
        <TextBox Text="{x:Bind ViewModel.EngineA, Mode=TwoWay}"
                 AutomationProperties.AutomationId="ABTestingView_EngineATextBox" />

        <TextBlock Text="Engine B" FontWeight="SemiBold" />
        <TextBox Text="{x:Bind ViewModel.EngineB, Mode=TwoWay}"
                 AutomationProperties.AutomationId="ABTestingView_EngineBTextBox" />

        <TextBlock Text="Emotion A (optional)" FontWeight="SemiBold" />
        <TextBox Text="{x:Bind ViewModel.EmotionA, Mode=TwoWay}"
                 PlaceholderText="Optional"
                 AutomationProperties.AutomationId="ABTestingView_EmotionATextBox" />

        <TextBlock Text="Emotion B (optional)" FontWeight="SemiBold" />
        <TextBox Text="{x:Bind ViewModel.EmotionB, Mode=TwoWay}"
                 PlaceholderText="Optional"
                 AutomationProperties.AutomationId="ABTestingView_EmotionBTextBox" />

        <StackPanel Orientation="Horizontal" Spacing="24">
          <CheckBox Content="Enhance quality A"
                    IsChecked="{x:Bind ViewModel.EnhanceQualityA, Mode=TwoWay}"
                    AutomationProperties.AutomationId="ABTestingView_EnhanceQualityACheckBox" />
          <CheckBox Content="Enhance quality B"
                    IsChecked="{x:Bind ViewModel.EnhanceQualityB, Mode=TwoWay}"
                    AutomationProperties.AutomationId="ABTestingView_EnhanceQualityBCheckBox" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Button Content="Run A/B test"
                  Command="{x:Bind ViewModel.RunTestCommand}"
                  AutomationProperties.AutomationId="ABTestingView_RunButton" />
          <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                        Width="32" Height="32"
                        AutomationProperties.AutomationId="ABTestingView_LoadingRing" />
        </StackPanel>

        <StackPanel Spacing="8"
                    Visibility="{x:Bind ViewModel.ResultsVisibility, Mode=OneWay}">
          <TextBlock Text="Sample A metrics" FontWeight="SemiBold" />
          <TextBlock Text="{x:Bind ViewModel.SampleAMetricsDisplay, Mode=OneWay}"
                     TextWrapping="WrapWholeWords"
                     AutomationProperties.AutomationId="ABTestingView_SampleAMetrics" />
          <TextBlock Text="Sample B metrics" FontWeight="SemiBold" />
          <TextBlock Text="{x:Bind ViewModel.SampleBMetricsDisplay, Mode=OneWay}"
                     TextWrapping="WrapWholeWords"
                     AutomationProperties.AutomationId="ABTestingView_SampleBMetrics" />
          <TextBlock Text="Comparison" FontWeight="SemiBold" />
          <TextBlock Text="{x:Bind ViewModel.ComparisonSummary, Mode=OneWay}"
                     TextWrapping="WrapWholeWords"
                     AutomationProperties.AutomationId="ABTestingView_ComparisonSummary" />
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Content="Play sample A"
                    Command="{x:Bind ViewModel.PlaySampleACommand}"
                    AutomationProperties.AutomationId="ABTestingView_PlaySampleAButton" />
            <Button Content="Play sample B"
                    Command="{x:Bind ViewModel.PlaySampleBCommand}"
                    AutomationProperties.AutomationId="ABTestingView_PlaySampleBButton" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <controls:HelpOverlay x:Name="HelpOverlay" Grid.RowSpan="2" IsVisible="False" Visibility="Collapsed"/>
  </Grid>
</UserControl>
