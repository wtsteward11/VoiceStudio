<UserControl x:Class="VoiceStudio.App.Views.Panels.APIKeyManagerView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="using:VoiceStudio.App.Controls"
  xmlns:local="using:VoiceStudio.App.Views.Panels"
  x:DataType="local:APIKeyManagerView">

  <Grid AutomationProperties.AutomationId="APIKeyManagerView_Root" Padding="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="API Key Manager" Style="{StaticResource SubtitleTextBlockStyle}"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Command="{x:Bind ViewModel.LoadServicesCommand}" Content="Load Services"/>
        <Button Command="{x:Bind ViewModel.RefreshCommand}" Content="Refresh"/>
      </StackPanel>
    </Grid>

    <ListView Grid.Row="1"
              ItemsSource="{x:Bind ViewModel.ApiKeys, Mode=OneWay}"
              SelectedItem="{x:Bind ViewModel.SelectedKey, Mode=TwoWay}">
      <ListView.ItemTemplate>
        <DataTemplate>
          <Grid Padding="8,6" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="120"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="{Binding ServiceName}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
              <TextBlock Text="{Binding Description}" Opacity="0.6" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding MaskedValue}" VerticalAlignment="Center" Opacity="0.5"
                       FontFamily="Consolas"/>
            <TextBlock Grid.Column="2" Text="{Binding Status}" VerticalAlignment="Center"/>
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>

    <Border Grid.Row="2" CornerRadius="4" Padding="12" Margin="0,8,0,0"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
      <StackPanel Spacing="8">
        <TextBlock Text="Add New Key" Style="{StaticResource BodyStrongTextBlockStyle}"/>
        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <ComboBox Grid.Column="0" Header="Service"
                    ItemsSource="{x:Bind ViewModel.SupportedServices, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.NewServiceName, Mode=TwoWay}"
                    HorizontalAlignment="Stretch"/>
          <PasswordBox Grid.Column="1" Header="API Key"
                       Password="{x:Bind ViewModel.NewKeyValue, Mode=TwoWay}"
                       PlaceholderText="sk-..."/>
        </Grid>
        <TextBox Header="Description" Text="{x:Bind ViewModel.NewDescription, Mode=TwoWay}"
                 PlaceholderText="Optional description"/>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Command="{x:Bind ViewModel.CreateKeyCommand}" Style="{StaticResource AccentButtonStyle}" Content="Add Key"/>
          <Button Command="{x:Bind ViewModel.ValidateKeyCommand}" Content="Validate Selected"/>
          <Button Command="{x:Bind ViewModel.DeleteKeyCommand}" Content="Delete Selected"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <StackPanel Grid.Row="3" Margin="0,8,0,0">
      <ProgressBar IsIndeterminate="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                   Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"/>
      <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" Severity="Error"
               Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"/>
    </StackPanel>

    <controls:HelpOverlay x:Name="HelpOverlay" IsVisible="False" Visibility="Collapsed"/>
  </Grid>
</UserControl>