<UserControl x:Class="VoiceStudio.App.Views.Panels.AdvancedWaveformVisualizationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:VoiceStudio.App.Controls"
    xmlns:local="using:VoiceStudio.App.Views.Panels"
    x:DataType="local:AdvancedWaveformVisualizationView">
    <Grid AutomationProperties.AutomationId="AdvancedWaveformVisualizationView_Root"
          Background="{StaticResource VSQ.Panel.Background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource VSQ.Panel.Background.HeaderBrush}"
                Padding="{StaticResource VSQ.Spacing.Medium}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE9D9;" FontSize="20"/>
                    <TextBlock Text="Advanced Waveform"
                               FontWeight="SemiBold"
                               FontSize="{StaticResource VSQ.FontSize.Title}"
                               Foreground="{StaticResource VSQ.Text.PrimaryBrush}"/>
                </StackPanel>
                <Button Grid.Column="1" Command="{x:Bind ViewModel.RefreshCommand}"
                        ToolTipService.ToolTip="Refresh"
                        AutomationProperties.AutomationId="AdvancedWaveformVisualizationView_RefreshButton">
                    <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                </Button>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="16" Spacing="12">

                <Border Background="{StaticResource VSQ.Panel.Background.DarkBrush}"
                        CornerRadius="{StaticResource VSQ.CornerRadius.Panel}" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Waveform Display" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource VSQ.Text.PrimaryBrush}"/>
                        <Border Height="200" CornerRadius="4" BorderThickness="1"
                                BorderBrush="{StaticResource VSQ.Panel.BorderBrush}">
                            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource VSQ.Text.SecondaryBrush}"/>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource VSQ.Panel.Background.DarkBrush}"
                        CornerRadius="{StaticResource VSQ.CornerRadius.Panel}" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Display Settings" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource VSQ.Text.PrimaryBrush}"/>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Zoom Level" FontSize="11" Foreground="{StaticResource VSQ.Text.SecondaryBrush}"/>
                            <Slider Minimum="1" Maximum="100" StepFrequency="1"
                                    Value="{x:Bind ViewModel.ZoomLevel, Mode=TwoWay}"
                                    AutomationProperties.AutomationId="AdvancedWaveformVisualizationView_ZoomSlider"/>
                        </StackPanel>
                        <ToggleSwitch IsOn="{x:Bind ViewModel.ShowRms, Mode=TwoWay}"
                                      Header="Show RMS"
                                      AutomationProperties.AutomationId="AdvancedWaveformVisualizationView_RmsToggle"/>
                        <ToggleSwitch IsOn="{x:Bind ViewModel.ShowPeak, Mode=TwoWay}"
                                      Header="Show Peaks"
                                      AutomationProperties.AutomationId="AdvancedWaveformVisualizationView_PeaksToggle"/>
                        <ToggleSwitch IsOn="{x:Bind ViewModel.ShowZeroCrossings, Mode=TwoWay}"
                                      Header="Show Zero Crossings"
                                      AutomationProperties.AutomationId="AdvancedWaveformVisualizationView_ZeroCrossingsToggle"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" FontSize="12"
                           Foreground="OrangeRed"/>
            </StackPanel>
        </ScrollViewer>

        <controls:HelpOverlay x:Name="HelpOverlay" Grid.RowSpan="2" IsVisible="False" Visibility="Collapsed"/>
    </Grid>
</UserControl>
