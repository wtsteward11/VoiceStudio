<UserControl x:Class="VoiceStudio.App.Views.Panels.BackupRestoreView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:VoiceStudio.App.Controls"
    xmlns:converters="using:VoiceStudio.App.Converters">
    <Grid AutomationProperties.AutomationId="BackupRestoreView_Root">
        <Grid.Resources>
            <converters:BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        </Grid.Resources>
        <StackPanel
            Margin="12,12,12,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            MaxWidth="560"
            Spacing="8">
            <TextBlock
                AutomationProperties.AutomationId="BackupRestore_MergeExpectationHint"
                Text="{Binding RestoreMergeExpectationHint}"
                TextWrapping="Wrap"
                IsTextSelectionEnabled="True" />
        <StackPanel
            Padding="10"
            HorizontalAlignment="Stretch"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Orientation="Horizontal"
            Spacing="12"
            Visibility="{Binding IsRestoring, Converter={StaticResource BoolToVisibilityConverter}}"
            AutomationProperties.AutomationId="BackupRestore_RestoreBusyRow">
            <ProgressRing
                Width="32"
                Height="32"
                IsActive="{Binding IsRestoring}" />
            <TextBlock
                MaxWidth="420"
                VerticalAlignment="Center"
                Text="{Binding RestoreBusyDetail}"
                TextWrapping="Wrap" />
            <Button
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="BackupRestore_CancelRestoreButton"
                Command="{Binding CancelRestoreCommand}"
                Content="{Binding CancelRestoreButtonText}" />
        </StackPanel>
        </StackPanel>
        <controls:HelpOverlay x:Name="HelpOverlay" IsVisible="False" Visibility="Collapsed" />
    </Grid>
</UserControl>
