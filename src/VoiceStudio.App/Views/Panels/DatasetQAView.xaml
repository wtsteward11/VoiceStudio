<UserControl x:Class="VoiceStudio.App.Views.Panels.DatasetQAView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="using:VoiceStudio.App.Controls"
  xmlns:local="using:VoiceStudio.App.Views.Panels"
  x:DataType="local:DatasetQAView">

  <Grid AutomationProperties.AutomationId="DatasetQAView_Root" Padding="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="Dataset QA" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,12"/>

    <Grid Grid.Row="1" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <ComboBox Grid.Column="0" Header="Dataset"
                ItemsSource="{x:Bind ViewModel.AvailableDatasets, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedDatasetId, Mode=TwoWay}"
                HorizontalAlignment="Stretch"/>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom" Margin="12,0,0,0">
        <Button Command="{x:Bind ViewModel.RunQACommand}" Style="{StaticResource AccentButtonStyle}" Content="Run QA"/>
        <Button Command="{x:Bind ViewModel.CullLowQualityCommand}" Content="Cull Low Quality"/>
        <Button Command="{x:Bind ViewModel.RefreshCommand}" Content="Refresh"/>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="200"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Spacing="12" Margin="0,0,12,0">
        <TextBlock Text="Thresholds" Style="{StaticResource BodyStrongTextBlockStyle}"/>
        <NumberBox Header="Min Quality" Value="{x:Bind ViewModel.MinQualityThreshold, Mode=TwoWay}"
                   Minimum="0" Maximum="5" SpinButtonPlacementMode="Compact" SmallChange="0.1"/>
        <NumberBox Header="Min SNR (dB)" Value="{x:Bind ViewModel.MinSnrThreshold, Mode=TwoWay}"
                   Minimum="0" Maximum="60" SpinButtonPlacementMode="Compact"/>
        <NumberBox Header="Max LUFS" Value="{x:Bind ViewModel.MaxLufsThreshold, Mode=TwoWay}"
                   Minimum="-60" Maximum="0" SpinButtonPlacementMode="Compact"/>
      </StackPanel>

      <ListView Grid.Column="1"
                ItemsSource="{x:Bind ViewModel.ClipResults, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedClipResult, Mode=TwoWay}">
        <ListView.ItemTemplate>
          <DataTemplate>
            <Grid Padding="8,4" ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="60"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{Binding ClipId}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="{Binding QualityScore}" VerticalAlignment="Center" Opacity="0.7"/>
              <TextBlock Grid.Column="2" Text="{Binding Snr}" VerticalAlignment="Center" Opacity="0.7"/>
              <TextBlock Grid.Column="3" Text="{Binding Status}" VerticalAlignment="Center"/>
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </Grid>

    <StackPanel Grid.Row="3">
      <ProgressBar IsIndeterminate="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                   Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"/>
      <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" Severity="Error" Title="Error"
               Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"/>
      <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Opacity="0.7" Margin="0,4,0,0"/>
    </StackPanel>

    <controls:HelpOverlay x:Name="HelpOverlay" IsVisible="False" Visibility="Collapsed"/>
  </Grid>
</UserControl>