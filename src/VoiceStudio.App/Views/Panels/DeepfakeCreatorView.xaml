<UserControl x:Class="VoiceStudio.App.Views.Panels.DeepfakeCreatorView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="using:VoiceStudio.App.Controls"
  xmlns:local="using:VoiceStudio.App.Views.Panels"
  x:DataType="local:DeepfakeCreatorView">

  <Grid AutomationProperties.AutomationId="DeepfakeCreatorView_Root" Padding="16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="300"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <ScrollViewer Grid.Column="0" Margin="0,0,12,0">
      <StackPanel Spacing="12">
        <TextBlock Text="Deepfake Creator" Style="{StaticResource SubtitleTextBlockStyle}"/>

        <ComboBox Header="Engine"
                  ItemsSource="{x:Bind ViewModel.AvailableEngines, Mode=OneWay}"
                  SelectedItem="{x:Bind ViewModel.SelectedEngine, Mode=TwoWay}"
                  DisplayMemberPath="Name" HorizontalAlignment="Stretch"/>

        <ComboBox Header="Media Type"
                  ItemsSource="{x:Bind ViewModel.AvailableMediaTypes, Mode=OneWay}"
                  SelectedItem="{x:Bind ViewModel.SelectedMediaType, Mode=TwoWay}"
                  HorizontalAlignment="Stretch"/>

        <TextBox Header="Source Face File" Text="{x:Bind ViewModel.SourceFaceFilePath, Mode=TwoWay}"
                 PlaceholderText="Path to source face image/video..."/>

        <TextBox Header="Target Media File" Text="{x:Bind ViewModel.TargetMediaFilePath, Mode=TwoWay}"
                 PlaceholderText="Path to target media file..."/>

        <ComboBox Header="Quality"
                  ItemsSource="{x:Bind ViewModel.AvailableQualities, Mode=OneWay}"
                  SelectedItem="{x:Bind ViewModel.SelectedQuality, Mode=TwoWay}"
                  HorizontalAlignment="Stretch"/>

        <CheckBox Content="Apply watermark" IsChecked="{x:Bind ViewModel.ApplyWatermark, Mode=TwoWay}"/>
        <CheckBox Content="I consent to ethical use" IsChecked="{x:Bind ViewModel.ConsentGiven, Mode=TwoWay}"/>

        <Button Command="{x:Bind ViewModel.CreateDeepfakeCommand}"
                Style="{StaticResource AccentButtonStyle}" Content="Create Deepfake"
                HorizontalAlignment="Stretch"/>

        <ProgressBar IsIndeterminate="{x:Bind ViewModel.IsProcessing, Mode=OneWay}"
                     Visibility="{x:Bind ViewModel.IsProcessing, Mode=OneWay}"/>

        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Command="{x:Bind ViewModel.LoadEnginesCommand}" Content="Refresh Engines"/>
          <Button Command="{x:Bind ViewModel.RefreshCommand}" Content="Refresh Jobs"/>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Text="Jobs" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,8"/>

      <ListView Grid.Row="1"
                ItemsSource="{x:Bind ViewModel.DeepfakeJobs, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedJob, Mode=TwoWay}">
        <ListView.ItemTemplate>
          <DataTemplate>
            <Grid Padding="8,4" ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{Binding Id}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="{Binding Status}" Opacity="0.7" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="2" Text="{Binding MediaType}" Opacity="0.5" VerticalAlignment="Center"/>
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </Grid>

    <controls:HelpOverlay x:Name="HelpOverlay" IsVisible="False" Visibility="Collapsed"/>
  </Grid>
</UserControl>