<UserControl x:Class="VoiceStudio.App.Views.Panels.EmbeddingExplorerView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="using:VoiceStudio.App.Controls"
  xmlns:local="using:VoiceStudio.App.Views.Panels"
  x:DataType="local:EmbeddingExplorerView">

  <Grid AutomationProperties.AutomationId="EmbeddingExplorerView_Root" Padding="16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="280"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Grid Grid.Column="0" Margin="0,0,12,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Text="Speaker Embedding Explorer" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,8"/>

      <StackPanel Grid.Row="1" Spacing="8" Margin="0,0,0,8">
        <ComboBox Header="Audio Source"
                  ItemsSource="{x:Bind ViewModel.AvailableAudioIds, Mode=OneWay}"
                  SelectedItem="{x:Bind ViewModel.SourceAudioId, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
        <ComboBox Header="Voice Profile"
                  ItemsSource="{x:Bind ViewModel.AvailableVoiceProfiles, Mode=OneWay}"
                  SelectedItem="{x:Bind ViewModel.SelectedVoiceProfileId, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
        <Button Command="{x:Bind ViewModel.ExtractEmbeddingCommand}" Style="{StaticResource AccentButtonStyle}"
                Content="Extract Embedding" HorizontalAlignment="Stretch"/>
      </StackPanel>

      <ListView Grid.Row="2"
                ItemsSource="{x:Bind ViewModel.Embeddings, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedEmbedding1, Mode=TwoWay}">
        <ListView.Header>
          <TextBlock Text="Embeddings" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,4"/>
        </ListView.Header>
        <ListView.ItemTemplate>
          <DataTemplate>
            <Grid Padding="4,2" ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="{Binding Dimensions}" Opacity="0.5" VerticalAlignment="Center"/>
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>

      <StackPanel Grid.Row="3" Spacing="4" Margin="0,8,0,0">
        <Button Command="{x:Bind ViewModel.CompareEmbeddingsCommand}" Content="Compare Selected" HorizontalAlignment="Stretch"/>
        <Button Command="{x:Bind ViewModel.DeleteEmbeddingCommand}" Content="Delete Selected" HorizontalAlignment="Stretch"/>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Command="{x:Bind ViewModel.ExportEmbeddingsCommand}" Content="Export"/>
          <Button Command="{x:Bind ViewModel.RefreshCommand}" Content="Refresh"/>
        </StackPanel>
      </StackPanel>
    </Grid>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
        <ComboBox Header="Visualization"
                  ItemsSource="{x:Bind ViewModel.AvailableVisualizationMethods, Mode=OneWay}"
                  SelectedItem="{x:Bind ViewModel.VisualizationMethod, Mode=TwoWay}" Width="150"/>
        <NumberBox Header="Dimensions" Value="{x:Bind ViewModel.VisualizationDimensions, Mode=TwoWay}"
                   Minimum="2" Maximum="3" SpinButtonPlacementMode="Compact"/>
        <NumberBox Header="Clusters" Value="{x:Bind ViewModel.NumClusters, Mode=TwoWay}"
                   Minimum="2" Maximum="20" SpinButtonPlacementMode="Compact"/>
        <Button Command="{x:Bind ViewModel.VisualizeEmbeddingsCommand}" Content="Visualize" VerticalAlignment="Bottom"/>
        <Button Command="{x:Bind ViewModel.ClusterEmbeddingsCommand}" Content="Cluster" VerticalAlignment="Bottom"/>
      </StackPanel>

      <Border Grid.Row="1" CornerRadius="4"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
        <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5"/>
      </Border>

      <StackPanel Grid.Row="2" Margin="0,8,0,0">
        <ProgressBar IsIndeterminate="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                     Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"/>
        <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" Severity="Error"
                 Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"/>
      </StackPanel>
    </Grid>

    <controls:HelpOverlay x:Name="HelpOverlay" IsVisible="False" Visibility="Collapsed"/>
  </Grid>
</UserControl>