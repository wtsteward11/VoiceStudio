<UserControl x:Class="VoiceStudio.App.Views.Panels.ModelManagerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:VoiceStudio.App.Controls"
    xmlns:local="using:VoiceStudio.App.Views.Panels"
    x:DataType="local:ModelManagerView">
    <Grid x:Name="ModelManagerView_Root" 
          AutomationProperties.AutomationId="ModelManagerView_Root"
          Background="{StaticResource VSQ.Panel.Background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" 
                Background="{StaticResource VSQ.Panel.Background.HeaderBrush}" 
                Padding="{StaticResource VSQ.Spacing.Medium}">
            <TextBlock Text="Model Manager" 
                       FontSize="{StaticResource VSQ.FontSize.Title}" 
                       Foreground="{StaticResource VSQ.Text.PrimaryBrush}" />
        </Border>

        <ScrollViewer Grid.Row="1"
                      Padding="{StaticResource VSQ.Spacing.Medium}"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="{StaticResource VSQ.Spacing.Value.Relaxed}">
                <TextBlock Text="Download from URL"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource VSQ.Text.PrimaryBrush}" />
                <TextBox x:Name="DownloadUrlBox"
                         AutomationProperties.AutomationId="ModelManager.DownloadUrl"
                         Header="URL"
                         Text="{x:Bind ViewModel.DownloadUrl, Mode=TwoWay}" />
                <TextBox AutomationProperties.AutomationId="ModelManager.DownloadModelName"
                         Header="Model name"
                         Text="{x:Bind ViewModel.DownloadModelName, Mode=TwoWay}" />
                <TextBox AutomationProperties.AutomationId="ModelManager.DownloadVersion"
                         Header="Version"
                         Text="{x:Bind ViewModel.DownloadVersion, Mode=TwoWay}" />
                <TextBox AutomationProperties.AutomationId="ModelManager.DownloadExpectedSha256"
                         Header="Expected SHA-256 (optional)"
                         Text="{x:Bind ViewModel.DownloadExpectedSha256, Mode=TwoWay}" />
                <ComboBox x:Name="DownloadEngineCombo"
                          AutomationProperties.AutomationId="ModelManager.DownloadEngine"
                          Header="Engine"
                          ItemsSource="{x:Bind ViewModel.Engines}"
                          SelectedItem="{x:Bind ViewModel.DownloadTargetEngine, Mode=TwoWay}" />
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource VSQ.Spacing.Value.Medium}">
                    <TextBlock Foreground="{StaticResource VSQ.Text.SecondaryBrush}" Text="Job:" />
                    <TextBlock Foreground="{StaticResource VSQ.Text.SecondaryBrush}" Text="{x:Bind ViewModel.ActiveDownloadJobId, Mode=OneWay}" />
                    <TextBlock Foreground="{StaticResource VSQ.Text.SecondaryBrush}" Text="Status:" />
                    <TextBlock Foreground="{StaticResource VSQ.Text.SecondaryBrush}" Text="{x:Bind ViewModel.DownloadJobStatus, Mode=OneWay}" />
                    <TextBlock Foreground="{StaticResource VSQ.Text.SecondaryBrush}" Text="Progress:" />
                    <TextBlock Foreground="{StaticResource VSQ.Text.SecondaryBrush}" Text="{x:Bind ViewModel.DownloadJobProgress, Mode=OneWay}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource VSQ.Spacing.Value.Medium}">
                    <Button AutomationProperties.AutomationId="ModelManager.StartDownload"
                            Content="Start download"
                            Command="{x:Bind ViewModel.StartModelDownloadCommand}" />
                    <Button AutomationProperties.AutomationId="ModelManager.CancelDownload"
                            Content="Cancel"
                            Command="{x:Bind ViewModel.CancelModelDownloadCommand}" />
                    <Button AutomationProperties.AutomationId="ModelManager.RetryDownload"
                            Content="Retry"
                            Command="{x:Bind ViewModel.RetryModelDownloadCommand}" />
                    <Button AutomationProperties.AutomationId="ModelManager.PauseDownload"
                            Content="Pause"
                            Command="{x:Bind ViewModel.PauseModelDownloadCommand}" />
                    <Button AutomationProperties.AutomationId="ModelManager.ResumeDownload"
                            Content="Resume"
                            Command="{x:Bind ViewModel.ResumeModelDownloadCommand}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <controls:HelpOverlay x:Name="HelpOverlay" 
                              Grid.RowSpan="2"
                              IsVisible="False" 
                              Visibility="Collapsed" />
    </Grid>
</UserControl>