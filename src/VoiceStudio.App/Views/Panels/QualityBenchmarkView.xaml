<UserControl x:Class="VoiceStudio.App.Views.Panels.QualityBenchmarkView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:VoiceStudio.App.Controls"
    xmlns:converters="using:VoiceStudio.App.Converters"
    xmlns:local="using:VoiceStudio.App.Views.Panels"
    x:DataType="local:QualityBenchmarkView">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>
    <Grid x:Name="QualityBenchmarkView_Root" 
          AutomationProperties.AutomationId="QualityBenchmarkView_Root"
          Background="{StaticResource VSQ.Panel.Background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" 
                Background="{StaticResource VSQ.Panel.Background.HeaderBrush}" 
                Padding="{StaticResource VSQ.Spacing.Medium}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Quality Benchmark" 
                           FontSize="{StaticResource VSQ.FontSize.Title}" 
                           Foreground="{StaticResource VSQ.Text.PrimaryBrush}" />
                <Button Grid.Column="1"
                        Content="Help"
                        Click="HelpButton_Click"
                        AutomationProperties.AutomationId="QualityBenchmarkView_HelpButton" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="1"
                   AutomationProperties.AutomationId="QualityBenchmarkView_SurfaceMaturityFootnote"
                   Text="{x:Bind ViewModel.SurfaceMaturityFootnote, Mode=OneWay}"
                   TextWrapping="WrapWholeWords"
                   FontSize="11"
                   Opacity="0.85"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Margin="{StaticResource VSQ.Spacing.Medium}" />

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="{StaticResource VSQ.Spacing.Medium}">
            <StackPanel Spacing="16" MaxWidth="920">
                <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                         Severity="Error"
                         Title="Quality benchmark"
                         Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                         AutomationProperties.AutomationId="QualityBenchmarkView_ErrorInfoBar" />

                <TextBlock Text="Profile" FontWeight="SemiBold" />
                <ComboBox ItemsSource="{x:Bind ViewModel.Profiles, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedProfile, Mode=TwoWay}"
                          DisplayMemberPath="Name"
                          PlaceholderText="Select a voice profile"
                          MinWidth="280"
                          HorizontalAlignment="Left"
                          AutomationProperties.AutomationId="QualityBenchmarkView_ProfileComboBox" />

                <TextBlock Text="Test text" FontWeight="SemiBold" />
                <TextBox Text="{x:Bind ViewModel.TestText, Mode=TwoWay}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="80"
                         AutomationProperties.AutomationId="QualityBenchmarkView_TestTextBox" />

                <TextBlock Text="Engines" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="24">
                    <CheckBox Content="XTTS"
                              IsChecked="{x:Bind ViewModel.TestXTTS, Mode=TwoWay}"
                              AutomationProperties.AutomationId="QualityBenchmarkView_EngineXTTSCheckBox" />
                    <CheckBox Content="Chatterbox"
                              IsChecked="{x:Bind ViewModel.TestChatterbox, Mode=TwoWay}"
                              AutomationProperties.AutomationId="QualityBenchmarkView_EngineChatterboxCheckBox" />
                    <CheckBox Content="Tortoise"
                              IsChecked="{x:Bind ViewModel.TestTortoise, Mode=TwoWay}"
                              AutomationProperties.AutomationId="QualityBenchmarkView_EngineTortoiseCheckBox" />
                </StackPanel>

                <CheckBox Content="Enhance quality (slower)"
                          IsChecked="{x:Bind ViewModel.EnhanceQuality, Mode=TwoWay}"
                          AutomationProperties.AutomationId="QualityBenchmarkView_EnhanceQualityCheckBox" />

                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Button Content="Run benchmark"
                            Command="{x:Bind ViewModel.RunBenchmarkCommand}"
                            AutomationProperties.AutomationId="QualityBenchmarkView_RunButton" />
                    <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                  Width="32" Height="32"
                                  AutomationProperties.AutomationId="QualityBenchmarkView_LoadingRing" />
                </StackPanel>

                <TextBlock Text="{x:Bind ViewModel.ResultsSummary, Mode=OneWay}"
                           FontWeight="SemiBold"
                           TextWrapping="WrapWholeWords"
                           Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                           AutomationProperties.AutomationId="QualityBenchmarkView_ResultsSummary" />

                <TextBlock Text="{x:Bind ViewModel.NextStepHint, Mode=OneWay}"
                           TextWrapping="WrapWholeWords"
                           Opacity="0.9"
                           FontSize="12"
                           Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                           AutomationProperties.AutomationId="QualityBenchmarkView_NextStepHint" />

                <TextBlock Text="Results" FontWeight="SemiBold"
                           Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                <ListView ItemsSource="{x:Bind ViewModel.BenchmarkResults, Mode=OneWay}"
                          SelectionMode="None"
                          IsItemClickEnabled="False"
                          Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                          AutomationProperties.AutomationId="QualityBenchmarkView_ResultsListView">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:BenchmarkResultViewModel">
                            <StackPanel Spacing="4" Padding="8">
                                <TextBlock FontWeight="SemiBold" Text="{x:Bind Engine, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind StatusDisplay, Mode=OneWay}" FontSize="12" />
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="MOS:" FontSize="11" />
                                        <TextBlock Text="{x:Bind MosScoreDisplay, Mode=OneWay}" FontSize="11" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Similarity:" FontSize="11" />
                                        <TextBlock Text="{x:Bind SimilarityDisplay, Mode=OneWay}" FontSize="11" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Time:" FontSize="11" />
                                        <TextBlock Text="{x:Bind TimeDisplay, Mode=OneWay}" FontSize="11" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ScrollViewer>

        <controls:HelpOverlay x:Name="HelpOverlay" 
                              Grid.RowSpan="3"
                              IsVisible="False" 
                              Visibility="Collapsed" />
    </Grid>
</UserControl>
