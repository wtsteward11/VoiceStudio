<UserControl x:Class="VoiceStudio.App.Views.Panels.SSMLControlView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:VoiceStudio.App.Controls"
    xmlns:vm="using:VoiceStudio.App.ViewModels"
    xmlns:local="using:VoiceStudio.App.Views.Panels"
    x:DataType="local:SSMLControlView">
    <Grid x:Name="SSMLControlView_Root" 
          AutomationProperties.AutomationId="SSMLControlView_Root"
          Background="{StaticResource VSQ.Panel.Background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" 
                Background="{StaticResource VSQ.Panel.Background.HeaderBrush}" 
                Padding="{StaticResource VSQ.Spacing.Medium}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                    Text="SSML Control" 
                    FontSize="{StaticResource VSQ.FontSize.Title}" 
                    Foreground="{StaticResource VSQ.Text.PrimaryBrush}"
                    VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="Preview" Command="{x:Bind ViewModel.PreviewCommand, Mode=OneWay}"
                        AutomationProperties.AutomationId="SSMLControlView_PreviewButton" />
                    <Button Content="Play" Command="{x:Bind ViewModel.PlayCommand, Mode=OneWay}"
                        AutomationProperties.AutomationId="SSMLControlView_PlayButton" />
                </StackPanel>
            </Grid>
        </Border>

        <controls:HelpOverlay x:Name="HelpOverlay" 
                              Grid.RowSpan="2"
                              IsVisible="False" 
                              Visibility="Collapsed" />
    </Grid>
</UserControl>