<UserControl x:Class="VoiceStudio.App.Views.Panels.VoiceBrowserView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:VoiceStudio.App.Controls"
    xmlns:local="using:VoiceStudio.App.Views.Panels"
    x:DataType="local:VoiceBrowserView">
    <Grid Background="{StaticResource VSQ.Panel.Background}">
        <TextBlock Text="VoiceBrowserView" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{StaticResource VSQ.Text.SecondaryBrush}" FontSize="14"/>
        <controls:HelpOverlay x:Name="HelpOverlay" IsVisible="False" Visibility="Collapsed"/>
    </Grid>
</UserControl>
