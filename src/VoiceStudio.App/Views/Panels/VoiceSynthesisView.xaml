<!--
  VoiceSynthesisView.xaml - Main TTS synthesis panel
  
  AI GUIDELINES:
  - ViewModel is in VoiceStudio.App.Views.Panels (not ViewModels)
  - Use {x:Bind ViewModel.Property} with x:DataType local:VoiceSynthesisView; ViewModel mirrors DataContext (single VM)
  - Engine selection ComboBox drives available voice options
  - SynthesizeCommand is async with built-in cancellation support
  - DO NOT modify the output audio player controls without updating IMediaPlayerService
  - Progress binding updates during synthesis - ensure Mode=OneWay
-->
<UserControl x:Class="VoiceStudio.App.Views.Panels.VoiceSynthesisView"
  x:Name="ThisView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:controls="using:VoiceStudio.App.Controls"
  xmlns:converters="using:VoiceStudio.App.Converters"
  xmlns:local="using:VoiceStudio.App.Views.Panels"
  mc:Ignorable="d"
  d:DataContext="{d:DesignInstance Type=local:VoiceSynthesisView, IsDesignTimeCreatable=False}"
  x:DataType="local:VoiceSynthesisView">
  
  <Grid AutomationProperties.AutomationId="VoiceSynthesisView_Root" Padding="16"
        AllowDrop="True"
        DragOver="VoiceSynthesisPanel_DragOver"
        Drop="VoiceSynthesisPanel_Drop">
    <Grid.Resources>
      <converters:BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
      <converters:InverseBooleanToVisibilityConverter x:Key="BoolToVisibilityInverseConverter" />
    </Grid.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    
    <!-- Row 0: Header -->
    <Grid Grid.Row="0" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      
      <StackPanel Orientation="Horizontal" Spacing="12">
        <FontIcon Glyph="&#xE768;" FontSize="24"/>
        <TextBlock Text="Voice Synthesis" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </StackPanel>
      
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button x:Name="RefreshButton"
                AutomationProperties.AutomationId="VoiceSynthesisView_RefreshButton"
                Command="{x:Bind ViewModel.LoadProfilesCommand}"
                ToolTipService.ToolTip="Refresh profiles and engines (F5)">
          <FontIcon Glyph="&#xE72C;" FontSize="14"/>
        </Button>
        <Button x:Name="HelpButton" Click="HelpButton_Click"
                AutomationProperties.AutomationId="VoiceSynthesisView_HelpButton"
                ToolTipService.ToolTip="Help">
          <FontIcon Glyph="&#xE897;" FontSize="14"/>
        </Button>
      </StackPanel>
    </Grid>
    
    <!-- Row 1: Profile and Engine Selection -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
      <StackPanel Spacing="4" MinWidth="200">
        <TextBlock Text="Voice Profile" FontSize="12" Opacity="0.7"/>
        <ComboBox x:Name="ProfileComboBox"
                  AutomationProperties.AutomationId="VoiceSynthesisView_ProfileComboBox"
                  ItemsSource="{x:Bind ViewModel.Profiles, Mode=OneWay}"
                  SelectedItem="{x:Bind ViewModel.SelectedProfile, Mode=TwoWay}"
                  HorizontalAlignment="Stretch"/>
      </StackPanel>
      
      <StackPanel Spacing="4" MinWidth="150">
        <TextBlock Text="Engine" FontSize="12" Opacity="0.7"/>
        <!-- GAP-CRIT-005: Engine selection; AvailableEngines is ObservableCollection<string> -->
        <ComboBox x:Name="EngineComboBox"
                  AutomationProperties.AutomationId="VoiceSynthesisView_EngineComboBox"
                  ItemsSource="{x:Bind ViewModel.AvailableEngines, Mode=OneWay}"
                  SelectedItem="{x:Bind ViewModel.SelectedEngine, Mode=TwoWay}"
                  HorizontalAlignment="Stretch"/>
      </StackPanel>
      
      <StackPanel Spacing="4" MinWidth="100">
        <TextBlock Text="Language" FontSize="12" Opacity="0.7"/>
        <ComboBox x:Name="LanguageComboBox"
                  AutomationProperties.AutomationId="VoiceSynthesisView_LanguageComboBox"
                  SelectedItem="{x:Bind ViewModel.Language, Mode=TwoWay}"
                  HorizontalAlignment="Stretch">
          <ComboBoxItem Content="en" IsSelected="True"/>
          <ComboBoxItem Content="es"/>
          <ComboBoxItem Content="fr"/>
          <ComboBoxItem Content="de"/>
          <ComboBoxItem Content="it"/>
          <ComboBoxItem Content="pt"/>
          <ComboBoxItem Content="zh"/>
          <ComboBoxItem Content="ja"/>
        </ComboBox>
      </StackPanel>
      
      <StackPanel Spacing="4" MinWidth="120">
        <TextBlock Text="Emotion preset" FontSize="12" Opacity="0.7"/>
        <ComboBox x:Name="EmotionComboBox"
                  AutomationProperties.AutomationId="VoiceSynthesisView_EmotionComboBox"
                  ItemsSource="{x:Bind ViewModel.CanonicalEmotionPresets, Mode=OneWay}"
                  SelectedItem="{x:Bind ViewModel.Emotion, Mode=TwoWay}"
                  PlaceholderText="Optional preset"
                  HorizontalAlignment="Stretch">
        </ComboBox>
      </StackPanel>
    </StackPanel>
    
    <!-- Row 2: Profile / engine compatibility (optional vs:engines: tag on profile) -->
    <StackPanel Grid.Row="2" Spacing="6" Margin="0,0,0,12">
      <TextBlock FontSize="12"
                 Opacity="0.85"
                 Foreground="{StaticResource VSQ.Text.SecondaryBrush}"
                 TextWrapping="WrapWholeWords"
                 Text="{x:Bind ViewModel.ProfileEngineCompatibilityMessage, Mode=OneWay}"
                 AutomationProperties.AutomationId="VoiceSynthesisView_ProfileEngineCompatibilitySummary" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Use first compatible profile"
                AutomationProperties.AutomationId="VoiceSynthesisView_SelectFirstCompatibleProfileButton"
                Command="{x:Bind ViewModel.SelectFirstCompatibleProfileCommand}" />
        <TextBlock VerticalAlignment="Center"
                   FontSize="12"
                   Opacity="0.7"
                   Foreground="{StaticResource VSQ.Text.SecondaryBrush}"
                   Text="No compatible profiles for this engine."
                   Visibility="{x:Bind ViewModel.ShowNoCompatibleProfilesHint, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
      </StackPanel>
      <InfoBar AutomationProperties.AutomationId="VoiceSynthesisView_ProfileEngineCompatibilityInfoBar"
               IsClosable="False"
               IsOpen="{x:Bind ViewModel.IsProfileEngineCompatibilityInfoBarOpen, Mode=OneWay}"
               Severity="{x:Bind ViewModel.ProfileEngineCompatibilityInfoBarSeverity, Mode=OneWay}"
               Title="Engine compatibility"
               Message="{x:Bind ViewModel.ProfileEngineCompatibilityMessage, Mode=OneWay}" />
    </StackPanel>
    
    <!-- Row 3: Text Input -->
    <TextBox x:Name="TextInput" Grid.Row="3"
             AutomationProperties.AutomationId="VoiceSynthesisView_TextInput"
             Text="{x:Bind ViewModel.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
             PlaceholderText="Enter text to synthesize..."
             TextWrapping="Wrap"
             AcceptsReturn="True"
             ScrollViewer.VerticalScrollBarVisibility="Auto"
             Margin="0,0,0,12"/>
    
    <!-- Row 4: Voice Controls (GAP-067 slice 5: primary tuning + Expander for advanced) -->
    <Grid Grid.Row="4" Margin="0,0,0,8">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Border Grid.Row="0" Background="{StaticResource VSQ.Panel.Background.DarkBrush}"
              CornerRadius="{StaticResource VSQ.CornerRadius.Panel}"
              Padding="12">
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE9D9;" FontSize="12" Foreground="{StaticResource VSQ.Accent.CyanBrush}" />
            <TextBlock Text="Controls" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource VSQ.Text.PrimaryBrush}" />
          </StackPanel>

          <!-- Speed -->
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="90" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="50" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SpeedLabel" Grid.Column="0" Text="Speed" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource VSQ.Text.SecondaryBrush}" />
            <Slider Grid.Column="1" Minimum="0.5" Maximum="2.0" StepFrequency="0.05"
                    AutomationProperties.LabeledBy="{x:Bind SpeedLabel}"
                    Value="{x:Bind ViewModel.Speed, Mode=TwoWay}" Height="{StaticResource VSQ.Touch.MinSize}" />
            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.Speed, Mode=OneWay}" VerticalAlignment="Center" FontSize="12" HorizontalAlignment="Right" Foreground="{StaticResource VSQ.Text.PrimaryBrush}" />
          </Grid>

          <!-- Pitch -->
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="90" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="50" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="PitchShiftLabel" Grid.Column="0" Text="Pitch Shift" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource VSQ.Text.SecondaryBrush}" />
            <Slider Grid.Column="1" Minimum="-12" Maximum="12" StepFrequency="1"
                    AutomationProperties.LabeledBy="{x:Bind PitchShiftLabel}"
                    Value="{x:Bind ViewModel.Pitch, Mode=TwoWay}" Height="{StaticResource VSQ.Touch.MinSize}" />
            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.Pitch, Mode=OneWay}" VerticalAlignment="Center" FontSize="12" HorizontalAlignment="Right" Foreground="{StaticResource VSQ.Text.PrimaryBrush}" />
          </Grid>

          <CheckBox Content="Enhance Quality"
                    AutomationProperties.AutomationId="VoiceSynthesisView_EnhanceQualityCheckBox"
                    IsChecked="{x:Bind ViewModel.EnhanceQuality, Mode=TwoWay}" FontSize="11" />
        </StackPanel>
      </Border>

      <Expander Grid.Row="1"
                IsExpanded="{x:Bind ViewModel.IsAdvancedSynthesisControlsExpanded, Mode=TwoWay}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                AutomationProperties.AutomationId="VoiceSynthesisView_AdvancedControlsExpander"
                AutomationProperties.Name="Advanced synthesis controls">
        <Expander.Header>
          <TextBlock Text="Advanced synthesis controls" FontWeight="SemiBold" />
        </Expander.Header>
        <StackPanel Spacing="8" Padding="0,4,0,0">
          <!-- Stability -->
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="90" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="50" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StabilityLabel" Grid.Column="0" Text="Stability" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource VSQ.Text.SecondaryBrush}" />
            <Slider Grid.Column="1" Minimum="0" Maximum="1" StepFrequency="0.01"
                    AutomationProperties.LabeledBy="{x:Bind StabilityLabel}"
                    Value="{x:Bind ViewModel.Stability, Mode=TwoWay}" Height="{StaticResource VSQ.Touch.MinSize}" />
            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.Stability, Mode=OneWay}" VerticalAlignment="Center" FontSize="12" HorizontalAlignment="Right" Foreground="{StaticResource VSQ.Text.PrimaryBrush}" />
          </Grid>

          <!-- Clarity -->
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="90" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="50" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ClarityLabel" Grid.Column="0" Text="Clarity" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource VSQ.Text.SecondaryBrush}" />
            <Slider Grid.Column="1" Minimum="0" Maximum="1" StepFrequency="0.01"
                    AutomationProperties.LabeledBy="{x:Bind ClarityLabel}"
                    Value="{x:Bind ViewModel.Clarity, Mode=TwoWay}" Height="{StaticResource VSQ.Touch.MinSize}" />
            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.Clarity, Mode=OneWay}" VerticalAlignment="Center" FontSize="12" HorizontalAlignment="Right" Foreground="{StaticResource VSQ.Text.PrimaryBrush}" />
          </Grid>

          <!-- Temperature -->
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="90" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="50" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TemperatureLabel" Grid.Column="0" Text="Temperature" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource VSQ.Text.SecondaryBrush}" />
            <Slider Grid.Column="1" Minimum="0" Maximum="1" StepFrequency="0.01"
                    AutomationProperties.LabeledBy="{x:Bind TemperatureLabel}"
                    Value="{x:Bind ViewModel.Temperature, Mode=TwoWay}" Height="{StaticResource VSQ.Touch.MinSize}" />
            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.Temperature, Mode=OneWay}" VerticalAlignment="Center" FontSize="12" HorizontalAlignment="Right" Foreground="{StaticResource VSQ.Text.PrimaryBrush}" />
          </Grid>

          <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
            <CheckBox Content="Multi-Engine"
                      AutomationProperties.AutomationId="VoiceSynthesisView_MultiEngineCheckBox"
                      IsChecked="{x:Bind ViewModel.UseMultiEngineEnsemble, Mode=TwoWay}" FontSize="11" />
            <CheckBox Content="Auto-Optimize"
                      AutomationProperties.AutomationId="VoiceSynthesisView_AutoApplyCheckBox"
                      IsChecked="{x:Bind ViewModel.AutoApplyRecommendations, Mode=TwoWay}"
                      ToolTipService.ToolTip="Automatically apply quality recommendations" FontSize="11" />
            <CheckBox Content="Streaming"
                      AutomationProperties.AutomationId="VoiceSynthesisView_StreamingModeCheckBox"
                      IsChecked="{x:Bind ViewModel.StreamingMode, Mode=TwoWay}"
                      ToolTipService.ToolTip="Enable real-time streaming playback" FontSize="11" />
            <CheckBox Content="Long-form mode"
                      AutomationProperties.AutomationId="VoiceSynthesisView_LongFormToggle"
                      IsChecked="{x:Bind ViewModel.UseLongForm, Mode=TwoWay}"
                      ToolTipService.ToolTip="Split long text into chunks on the server and merge into one file"
                      FontSize="11" />
          </StackPanel>

          <Grid Visibility="{x:Bind ViewModel.StreamingMode, Mode=OneWay}" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <FontIcon Grid.Column="0" Glyph="&#xE93E;" FontSize="12" Foreground="{StaticResource VSQ.Accent.MagentaBrush}"
                      Visibility="{x:Bind ViewModel.IsStreaming, Mode=OneWay}" Margin="0,0,8,0"/>
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.StreamingStatus, Mode=OneWay}"
                       FontSize="11" Foreground="{StaticResource VSQ.Text.SecondaryBrush}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" FontSize="11" Foreground="{StaticResource VSQ.Text.SecondaryBrush}" VerticalAlignment="Center"
                       Text="{x:Bind ViewModel.StreamingChunksSummary, Mode=OneWay}"/>
          </Grid>
        </StackPanel>
      </Expander>

      <TextBlock Grid.Row="2"
                 Margin="0,8,0,0"
                 FontSize="12"
                 Opacity="0.85"
                 Foreground="{StaticResource VSQ.Text.SecondaryBrush}"
                 Text="{x:Bind ViewModel.LongFormProgressText, Mode=OneWay}"
                 AutomationProperties.AutomationId="VoiceSynthesisView_LongFormProgressText"
                 Visibility="{x:Bind ViewModel.IsLongFormRunning, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
    </Grid>
    
    <!-- Row 5: Actions -->
    <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
      <Button Style="{StaticResource AccentButtonStyle}"
              AutomationProperties.AutomationId="VoiceSynthesisView_SynthesizeButton"
              Command="{x:Bind ViewModel.SynthesizeCommand}"
              Visibility="{x:Bind ViewModel.StreamingMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityInverseConverter}}"
              ToolTipService.ToolTip="Synthesize speech (Ctrl+Enter)">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <FontIcon Glyph="&#xE768;" FontSize="14"/>
          <TextBlock Text="Synthesize"/>
        </StackPanel>
      </Button>
      <Button Style="{StaticResource AccentButtonStyle}"
              AutomationProperties.AutomationId="VoiceSynthesisView_StreamButton"
              Command="{x:Bind ViewModel.StartStreamingCommand}"
              Visibility="{x:Bind ViewModel.StreamingMode, Mode=OneWay}"
              ToolTipService.ToolTip="Start streaming synthesis (Ctrl+Enter)">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <FontIcon Glyph="&#xE93E;" FontSize="14"/>
          <TextBlock Text="Stream"/>
        </StackPanel>
      </Button>
      <Button AutomationProperties.AutomationId="VoiceSynthesisView_StopStreamButton"
              Command="{x:Bind ViewModel.StopStreamingCommand}"
              Visibility="{x:Bind ViewModel.IsStreaming, Mode=OneWay}"
              ToolTipService.ToolTip="Stop streaming">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <FontIcon Glyph="&#xE71A;" FontSize="14"/>
          <TextBlock Text="Stop Stream"/>
        </StackPanel>
      </Button>
      <Button AutomationProperties.AutomationId="VoiceSynthesisView_PlayButton"
              Command="{x:Bind ViewModel.PlayAudioCommand}"
              IsEnabled="{x:Bind ViewModel.CanPlayAudio, Mode=OneWay}"
              ToolTipService.ToolTip="Play synthesized audio (Space)">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <FontIcon Glyph="&#xE768;" FontSize="14"/>
          <TextBlock Text="Play"/>
        </StackPanel>
      </Button>
      <Button AutomationProperties.AutomationId="VoiceSynthesisView_StopButton"
              Command="{x:Bind ViewModel.StopAudioCommand}"
              ToolTipService.ToolTip="Stop playback (Escape)">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <FontIcon Glyph="&#xE71A;" FontSize="14"/>
          <TextBlock Text="Stop"/>
        </StackPanel>
      </Button>
      <Button AutomationProperties.AutomationId="VoiceSynthesisView_AddToTimelineButton"
              Command="{x:Bind ViewModel.AddToTimelineCommand}"
              ToolTipService.ToolTip="Add synthesized audio to Timeline as a new clip">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <FontIcon Glyph="&#xE710;" FontSize="14"/>
          <TextBlock Text="Add to Timeline"/>
        </StackPanel>
      </Button>
      <Button AutomationProperties.AutomationId="VoiceSynthesisView_AnalyzeButton"
              Command="{x:Bind ViewModel.AnalyzeTextCommand}"
              ToolTipService.ToolTip="Analyze text for optimal synthesis settings">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <FontIcon Glyph="&#xE9D9;" FontSize="14"/>
          <TextBlock Text="Analyze"/>
        </StackPanel>
      </Button>
      <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                    Width="24" Height="24" Margin="8,0,0,0"/>
      <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay, FallbackValue='Ready', TargetNullValue='Ready'}"
                 VerticalAlignment="Center" Opacity="0.7" Margin="8,0,0,0"/>
    </StackPanel>
    
    <!-- Row 6: Generated audio result -->
    <Border Grid.Row="6"
            AutomationProperties.AutomationId="VoiceSynthesisView_GeneratedAudioPanel"
            Background="{StaticResource VSQ.Panel.Background.DarkBrush}"
            CornerRadius="{StaticResource VSQ.CornerRadius.Panel}"
            Padding="12"
            Margin="0,0,0,8"
            Visibility="{x:Bind ViewModel.HasSynthesisResult, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
      <StackPanel Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <FontIcon Glyph="&#xE8D6;" FontSize="12" Foreground="{StaticResource VSQ.Accent.CyanBrush}"/>
          <TextBlock Text="Generated audio"
                     FontSize="13"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource VSQ.Text.PrimaryBrush}"/>
        </StackPanel>
        <TextBlock AutomationProperties.AutomationId="VoiceSynthesisView_GeneratedAudioSummaryText"
                   Text="{x:Bind ViewModel.SynthesisResultSummary, Mode=OneWay}"
                   TextWrapping="Wrap"
                   FontSize="12"
                   Foreground="{StaticResource VSQ.Text.SecondaryBrush}"/>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Copy ID"
                  AutomationProperties.AutomationId="VoiceSynthesisView_CopyAudioIdButton"
                  Command="{x:Bind ViewModel.CopyAudioIdCommand}"
                  IsEnabled="{x:Bind ViewModel.CanCopyAudioId, Mode=OneWay}"
                  ToolTipService.ToolTip="Copy generated audio ID"/>
          <Button Content="Copy Reference"
                  AutomationProperties.AutomationId="VoiceSynthesisView_CopyAudioReferenceButton"
                  Command="{x:Bind ViewModel.CopyAudioReferenceCommand}"
                  IsEnabled="{x:Bind ViewModel.CanCopyAudioReference, Mode=OneWay}"
                  ToolTipService.ToolTip="Copy generated audio URL or path"/>
          <Button Content="Open Location"
                  AutomationProperties.AutomationId="VoiceSynthesisView_OpenOutputLocationButton"
                  Command="{x:Bind ViewModel.OpenOutputLocationCommand}"
                  IsEnabled="{x:Bind ViewModel.CanOpenOutputLocation, Mode=OneWay}"
                  ToolTipService.ToolTip="Open the local output file or folder"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Row 7: Recent generated audio (in-memory, last 5) -->
    <Border Grid.Row="7"
            Padding="12,8"
            Margin="0,0,0,8"
            Visibility="{x:Bind ViewModel.HasRecentSynthesisResults, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
            AutomationProperties.AutomationId="VoiceSynthesisView_RecentResultsPanel"
            Background="{StaticResource VSQ.Panel.Background.DarkBrush}"
            CornerRadius="{StaticResource VSQ.CornerRadius.Panel}">
      <StackPanel Spacing="6">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="Recent generated audio"
                     VerticalAlignment="Center"
                     FontSize="12"
                     Foreground="{StaticResource VSQ.Text.SecondaryBrush}"/>
          <Button Content="Clear recent"
                  AutomationProperties.AutomationId="VoiceSynthesisView_ClearRecentResultsButton"
                  Command="{x:Bind ViewModel.ClearRecentResultsCommand}"
                  ToolTipService.ToolTip="Remove all entries from this list (does not delete audio files)"/>
        </StackPanel>
        <ListView ItemsSource="{x:Bind ViewModel.RecentSynthesisResults, Mode=OneWay}"
                  SelectedItem="{x:Bind ViewModel.SelectedRecentResult, Mode=TwoWay}"
                  SelectionMode="Single"
                  MaxHeight="200"
                  AutomationProperties.AutomationId="VoiceSynthesisView_RecentResultsList">
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="local:VoiceSynthesisRecentResult">
              <Grid Padding="4,2" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="2">
                  <TextBlock Text="{x:Bind Summary, Mode=OneWay}"
                             Style="{ThemeResource BodyTextBlockStyle}"
                             TextTrimming="CharacterEllipsis"
                             Foreground="{StaticResource VSQ.Text.PrimaryBrush}"/>
                  <TextBlock Text="{x:Bind DetailLine, Mode=OneWay}"
                             TextWrapping="Wrap"
                             FontSize="11"
                             Foreground="{StaticResource VSQ.Text.SecondaryBrush}"/>
                  <TextBlock Text="{x:Bind CreatedAtLabel, Mode=OneWay}"
                             FontSize="11"
                             Foreground="{StaticResource VSQ.Text.TertiaryBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Center">
                  <Button Content="Use"
                          VerticalAlignment="Center"
                          AutomationProperties.AutomationId="VoiceSynthesisView_RestoreRecentResultButton"
                          Command="{Binding ViewModel.RestoreRecentResultCommand, ElementName=ThisView, Mode=OneWay}"
                          CommandParameter="{x:Bind}"
                          ToolTipService.ToolTip="Restore as the active generated audio result"/>
                  <Button Content="Remove"
                          VerticalAlignment="Center"
                          AutomationProperties.AutomationId="VoiceSynthesisView_RemoveRecentResultButton"
                          Command="{Binding ViewModel.RemoveRecentResultCommand, ElementName=ThisView, Mode=OneWay}"
                          CommandParameter="{x:Bind}"
                          ToolTipService.ToolTip="Remove this entry from the list (does not delete the file)"/>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
      </StackPanel>
    </Border>

    <!-- Row 8: Consent required (recoverable) -->
    <InfoBar Grid.Row="8"
             AutomationProperties.AutomationId="VoiceSynthesisView_ConsentInfoBar"
             IsOpen="{x:Bind ViewModel.IsConsentRequired, Mode=OneWay}"
             Severity="Warning"
             Title="Consent required"
             Message="{x:Bind ViewModel.ConsentRequiredMessage, Mode=OneWay, FallbackValue='This voice profile requires consent before synthesis. Open Profiles to grant access, then retry.', TargetNullValue='This voice profile requires consent before synthesis. Open Profiles to grant access, then retry.'}"
             IsClosable="True"
             Closed="ConsentInfoBar_Closed">
      <InfoBar.ActionButton>
        <Button Content="Go to profile"
                AutomationProperties.AutomationId="VoiceSynthesisView_GoToProfileButton"
                Command="{x:Bind ViewModel.OpenProfileConsentCommand}"
                ToolTipService.ToolTip="Open the Profiles panel for this profile"/>
      </InfoBar.ActionButton>
      <InfoBar.Content>
        <Button Content="Retry synthesis"
                Margin="0,4,0,0"
                AutomationProperties.AutomationId="VoiceSynthesisView_RetryConsentButton"
                Command="{x:Bind ViewModel.RetrySynthesisCommand}"
                ToolTipService.ToolTip="Retry after granting consent"/>
      </InfoBar.Content>
    </InfoBar>
    
    <!-- Row 9: Playback error (generated audio exists but playback failed) -->
    <InfoBar Grid.Row="9"
             AutomationProperties.AutomationId="VoiceSynthesisView_PlaybackErrorInfoBar"
             IsOpen="{x:Bind ViewModel.ShowPlaybackError, Mode=OneWay}"
             Severity="Error"
             Title="Playback failed"
             Message="{x:Bind ViewModel.PlaybackErrorMessage, Mode=OneWay, FallbackValue='Failed to play audio', TargetNullValue='Failed to play audio'}"
             IsClosable="True"
             Closed="PlaybackErrorInfoBar_Closed">
      <InfoBar.ActionButton>
        <Button Content="Retry"
                AutomationProperties.AutomationId="VoiceSynthesisView_RetryPlaybackButton"
                Command="{x:Bind ViewModel.RetryPlaybackCommand}"
                ToolTipService.ToolTip="Retry playing the generated audio"/>
      </InfoBar.ActionButton>
      <InfoBar.Content>
        <Button Content="Copy error"
                Margin="0,4,0,0"
                AutomationProperties.AutomationId="VoiceSynthesisView_CopyPlaybackErrorButton"
                Command="{x:Bind ViewModel.CopyPlaybackErrorCommand}"
                ToolTipService.ToolTip="Copy playback error details to clipboard"/>
      </InfoBar.Content>
    </InfoBar>
    
    <!-- Row 10: Error/Status InfoBar (hidden while consent callout is primary) -->
    <InfoBar Grid.Row="10"
             AutomationProperties.AutomationId="VoiceSynthesisView_ErrorInfoBar"
             IsOpen="{x:Bind ViewModel.ShowGenericSynthesisError, Mode=OneWay}"
             Severity="Error"
             Title="Synthesis Error"
             Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, FallbackValue='An error occurred', TargetNullValue='An error occurred'}"
             IsClosable="True"
             Closed="ErrorInfoBar_Closed">
      <InfoBar.ActionButton>
        <Button Content="Copy details"
                AutomationProperties.AutomationId="VoiceSynthesisView_CopyErrorButton"
                Command="{x:Bind ViewModel.CopyLastErrorCommand}"
                ToolTipService.ToolTip="Copy error details to clipboard"/>
      </InfoBar.ActionButton>
    </InfoBar>
    
    <!-- Help Overlay -->
    <controls:HelpOverlay x:Name="HelpOverlay" IsVisible="False" Visibility="Collapsed" d:Visibility="Collapsed" Grid.RowSpan="11"/>
    
    <!-- Loading Overlay -->
    <Grid Grid.RowSpan="11" 
          Background="{ThemeResource SystemControlBackgroundAltMediumHighBrush}"
          Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
          d:Visibility="Collapsed">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
        <ProgressRing IsActive="True" Width="48" Height="48"/>
        <TextBlock Text="Synthesizing..." FontSize="16" Opacity="0.8"/>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
