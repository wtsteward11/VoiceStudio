<Project Sdk="Microsoft.NET.Sdk">

  <!-- XAML bypass targets are imported via Directory.Build.targets (after NuGet) -->
  <!-- Do NOT import here - it must be AFTER NuGet package targets -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <RootNamespace>VoiceStudio.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>enable</Nullable>
    <UseWinUI>true</UseWinUI>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <!-- Tell platform compatibility analyzer about minimum supported Windows version -->
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <!-- Suppress platform compatibility warnings - this app is Windows-only (CA1416 is false positive for Windows-only app) -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <!-- Ensure WinRT.Runtime reference assemblies are available to XAML compiler. -->
    <WindowsSdkPackageVersion>10.0.26100.81</WindowsSdkPackageVersion>
    <Platform>x64</Platform>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <IsPackable>false</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <!-- WindowsAppSDKSelfContained=true bundles CoreMessagingXP.dll which crashes on
         Windows Insider builds (STATUS_FAIL_FAST 0xc0000602). Use system runtime. -->
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <UseAppHost>true</UseAppHost>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- EnableWin32Codegen and UseVCMetaManaged set in Directory.Build.targets -->
    <!-- XBF disabled: WinAppSDK 1.8.5 XAML compiler Pass 2 still does not produce
         .xbf files (187 MSB3030 errors, tested 2026-02-26 with both 1.8.1 and 1.8.5).
         The app parses XAML at runtime. Custom types via EnableTypeInfoReflection=true.
         Re-test when WinAppSDK 1.9+ ships XBF pipeline fixes. -->
    <DisableXbfGeneration>true</DisableXbfGeneration>
    <CppWinRTFastAbi>false</CppWinRTFastAbi>
    <BaseOutputPath>$(SolutionDir).buildlogs\</BaseOutputPath>
    <!-- FIX: Don't use architecture-specific sub-paths that cause double backslash in XAML compiler
    Exec command -->
    <!-- Set a simple flat structure for intermediate output to avoid the escaping issue -->
    <IntermediateOutputPathHasTrailingSlash>false</IntermediateOutputPathHasTrailingSlash>
    <EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
    <Win2DWarnNoPlatform>true</Win2DWarnNoPlatform>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Unpackaged apphost EXE defaults -->
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>
    <EnableDefaultPriItems>false</EnableDefaultPriItems>
    <GenerateAppxPackageOnBuild>false</GenerateAppxPackageOnBuild>
    <AppxPackageDir />
    <AppxBundle>Never</AppxBundle>
    <AppxManifest />
  </PropertyGroup>

  <PropertyGroup>
    <WindowsAppSDKRuntimePackageVersion>$(MicrosoftWindowsAppSDKVersion)</WindowsAppSDKRuntimePackageVersion>
    <WindowsAppSDKRuntimePackageRoot>
      $(UserProfile)\.nuget\packages\microsoft.windowsappsdk.runtime\$(WindowsAppSDKRuntimePackageVersion)</WindowsAppSDKRuntimePackageRoot>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <WarningLevel>9999</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <WarningLevel>9999</WarningLevel>
  </PropertyGroup>

  <!-- EnsureRuntimeIdentifierForWin2D removed: explicit RuntimeIdentifier=win-x64 set above -->

  <!-- CaptureXamlErrors removed: diagnostic stub that never created output file -->
  <!-- IncludeXbfInPublishOutput removed: DisableXbfGeneration=true means no XBF files exist.
       Re-add when XBF generation is restored. -->

  <Target Name="ExcludeSystemDllsFromPublish" AfterTargets="Publish" Condition="'$(SelfContained)' == 'true' And '$(WindowsAppSDKSelfContained)' != 'true'">
    <ItemGroup>
      <SystemDlls Include="$(PublishDir)\CoreMessagingXP.dll" />
      <SystemDlls Include="$(PublishDir)\dcompi.dll" />
      <SystemDlls Include="$(PublishDir)\dwmcorei.dll" />
      <SystemDlls Include="$(PublishDir)\Microsoft.ui.xaml.dll" />
      <SystemDlls Include="$(PublishDir)\Microsoft.ui.xaml.resources.common.dll" />
      <SystemDlls Include="$(PublishDir)\Microsoft.ui.xaml.resources.19h1.dll" />
      <SystemDlls Include="$(PublishDir)\Microsoft.UI.Xaml.Controls.dll" />
      <SystemDlls Include="$(PublishDir)\Microsoft.UI.Xaml.Internal.dll" />
      <SystemDlls Include="$(PublishDir)\Microsoft.UI.Xaml.Phone.dll" />
      <SystemDlls Include="$(PublishDir)\Microsoft.UI.Xaml.winmd" />
    </ItemGroup>
    <Delete Files="@(SystemDlls)" Condition="Exists('%(Identity)')" ContinueOnError="true" />
    <Message Text="Removed Windows App Runtime native DLLs from publish: @(SystemDlls, ', ')" Condition="'@(SystemDlls)' != ''" Importance="high" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\VoiceStudio.Core\VoiceStudio.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" Version="8.0.5" />
    <PackageReference Include="MessagePack" Version="3.1.4" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.3.2" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="$(MicrosoftWindowsAppSDKVersion)" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <!-- Required for in-proc XAML compiler task dependency -->
    <PackageReference Include="System.Security.Permissions" Version="6.0.0" />
    <PackageReference Include="CommunityToolkit.WinUI.UI.Controls" Version="7.1.2">
      <PrivateAssets>none</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.1" />
    <PackageReference Include="Roslynator.Analyzers" Version="4.11.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>


  <ItemGroup>
    <!-- Exclude duplicate model files - models should be in VoiceStudio.Core.Models or
    VoiceStudio.App.Core.Models -->
    <Compile Remove="Models\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="app.manifest" />
    <!-- MSIX lane removed: Package.appxmanifest archived under docs/archive/msix/ -->
  </ItemGroup>

  <!-- Ensure control XAMLs carry Page metadata -->
  <ItemGroup>
    <Page Update="Controls\**\*.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>

  <!-- XAML crash isolation switches removed to prevent Visual Studio project system
  KeyNotFoundException -->
  <!-- These debug conditionals referenced undefined variables causing project system failures -->
  <!-- Can be re-added as needed for XAML crash isolation debugging -->
  <!-- Debug-only XAML compilation targets removed to prevent Visual Studio project system issues -->
  <!-- These can be re-enabled if needed for XAML debugging -->

  <ItemGroup>
    <PRIResource Include="Resources\Resources.resw" />
    <PRIResource Include="Resources\en-US\Resources.resw" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Assets\**\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\shared\schemas\*.schema.json" Link="shared\schemas\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\shared\schemas\_registry.json" Link="shared\schemas\_registry.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\shared\contracts\*.schema.json" Link="shared\contracts\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\shared\contracts\error_codes.json" Link="shared\contracts\error_codes.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- De-dupe ALL XAML-generated Compile items in design-time builds (LSP/VS).
       The default compile glob (EnableDefaultCompileItems) picks up obj/**/*.g.cs,
       and the XAML compiler also adds them, causing CS2002 duplicate warnings.
       This target removes duplicates for ALL .g.cs and .g.i.cs files, not just App. -->
  <Target Name="DeduplicateCompileItemsDesignTime"
      AfterTargets="DesignTimeMarkupCompilation;MarkupCompilePass1"
      Condition="'$(DesignTimeBuild)' == 'true' Or '$(BuildingInsideVisualStudio)' == 'true'">
    <ItemGroup>
      <_GenDup Include="@(Compile)"
        Condition="$([System.String]::Copy('%(Compile.Identity)').EndsWith('.g.cs'))
                Or $([System.String]::Copy('%(Compile.Identity)').EndsWith('.g.i.cs'))" />
    </ItemGroup>
    <RemoveDuplicates Inputs="@(_GenDup->'%(FullPath)')">
      <Output TaskParameter="Filtered" ItemName="_GenUnique" />
    </RemoveDuplicates>
    <ItemGroup>
      <Compile Remove="@(_GenDup)" />
      <Compile Include="@(_GenUnique)" />
    </ItemGroup>
  </Target>

  <!-- De-dupe XAML-generated Compile items before the C# compiler runs.
       Must use BeforeTargets="CoreCompile" because CoreCompile (CSC) runs
       between MarkupCompilePass1 and Pass2 in the WinUI pipeline. -->
  <Target Name="DeduplicateGeneratedCompileItems"
      BeforeTargets="CoreCompile"
      Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_GenDupBuild Include="@(Compile)"
        Condition="$([System.String]::Copy('%(Compile.Identity)').EndsWith('.g.cs'))
                Or $([System.String]::Copy('%(Compile.Identity)').EndsWith('.g.i.cs'))" />
    </ItemGroup>
    <RemoveDuplicates Inputs="@(_GenDupBuild->'%(FullPath)')">
      <Output TaskParameter="Filtered" ItemName="_GenUniqueBuild" />
    </RemoveDuplicates>
    <ItemGroup>
      <Compile Remove="@(_GenDupBuild)" />
      <Compile Include="@(_GenUniqueBuild)" />
    </ItemGroup>
  </Target>

</Project>